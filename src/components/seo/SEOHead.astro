---
import { localeDefinitions, type Locale } from '../../i18n/locales';
import { getPublishedCounterpart, resolveCounterpartPath, type PageId, type RoutePath } from '../../i18n/routes';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  imageAlt?: string;
  canonicalURL?: string;
  locale?: Locale;
  pageId?: PageId;
}

const {
  title,
  description,
  ogImage,
  imageAlt = 'Duartes Auto Detailing mobile detailing service',
  canonicalURL,
  locale = 'en-US',
  pageId,
} = Astro.props;

const fullTitle = title.includes('Duartes Auto Detailing')
  ? title
  : `${title} | Duartes Auto Detailing`;
const siteBase = Astro.site ?? Astro.url;
const canonicalHref = canonicalURL ?? new URL(Astro.url.pathname, siteBase).href;
const fallbackOgImage = 'https://res.cloudinary.com/dkq4plo7s/image/upload/f_auto,q_auto,w_1200,h_630,c_fill/og-image_usi1ab';
const imageHref = new URL(ogImage ?? fallbackOgImage, siteBase).href;
const twitterCard = 'summary_large_image';
const localeDefinition = localeDefinitions[locale];
let counterpart = getPublishedCounterpart(pageId, locale);
if (counterpart) {
  counterpart = {
    ...counterpart,
    path: resolveCounterpartPath(counterpart.path, Astro.url.pathname) as RoutePath,
  };
}
const counterpartHref = counterpart ? new URL(counterpart.path, siteBase).href : undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={canonicalHref} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
<link rel="dns-prefetch" href="https://res.cloudinary.com" />
{counterpartHref && (
  <>
    <link rel="alternate" hreflang={localeDefinition.htmlLang} href={canonicalHref} />
    <link rel="alternate" hreflang={localeDefinitions[counterpart!.locale].htmlLang} href={counterpartHref} />
  </>
)}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalHref} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageHref} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={localeDefinition.ogLocale} />
<meta property="og:site_name" content="Duartes Auto Detailing" />

<!-- Twitter / X Card -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageHref} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
