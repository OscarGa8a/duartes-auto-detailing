---
import { CldImage } from "astro-cloudinary";
import type { AboutContent } from "../../../i18n/content-types";

interface Props {
  content: AboutContent["behindTheShine"];
}

const { content } = Astro.props;
const isSpanish = content.eyebrow.startsWith("Detrás");
---

<section class="bg-black py-10 lg:py-16 relative overflow-hidden border-b border-border-soft">
  <div class="motion-drift absolute -left-10 bottom-0 h-64 w-64 rounded-full bg-wine/10 blur-3xl"></div>
  <div class="motion-drift absolute right-0 top-10 h-56 w-56 rounded-full bg-off-white/6 blur-3xl" style="--float-delay: 1.2s"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[0.88fr_1.12fr] gap-8 lg:gap-14 items-center">
    <div data-reveal="blur" class="flex flex-col gap-5">
      <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold">
        <span class="h-px w-10 bg-gold"></span>
        {content.eyebrow}
      </span>
      <h2 class="text-text-primary font-bold text-h2">
        {content.title}
      </h2>
      <p class="text-text-secondary leading-relaxed">
        {content.description}
      </p>
      <div data-reveal="scale" style="--reveal-delay: 180ms" class="motion-card-hover relative overflow-hidden rounded-xl border border-wine-soft/20 bg-[linear-gradient(180deg,rgba(110,43,44,0.16),rgba(23,24,27,0.96))] px-6 py-6 shadow-lg">
        <div class="motion-sheen"></div>
        <p class="text-wine-tint font-medium italic leading-relaxed">
          "{content.quote}"
        </p>
      </div>
      <div class="pt-2 flex flex-col gap-2.5">
        <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">
          {isSpanish ? 'Servicio móvil en toda la Bay Area' : 'Mobile Service Across The Bay Area'}
        </span>
        <div class="flex flex-wrap gap-2 text-xs text-text-secondary">
          {[
            { name: "San Jose", slug: "san-jose" },
            { name: "San Francisco", slug: "san-francisco" },
            { name: "Oakland", slug: "oakland" },
            { name: "Fremont", slug: "fremont" },
            { name: "Berkeley", slug: "berkeley" },
            { name: "Walnut Creek", slug: "walnut-creek" },
          ].map((city) => (
            <a
              href={isSpanish ? `/es/service-area/${city.slug}/` : `/service-area/${city.slug}/`}
              class="rounded-full bg-white/4 px-3.5 py-1.5 border border-white/8 hover:border-gold/40 hover:text-gold transition-colors active:scale-[0.98] touch-manipulation"
            >
              {city.name}
            </a>
          ))}
          <a href={isSpanish ? "/es/service-area/bay-area/" : "/service-area/bay-area/"} class="inline-flex items-center gap-1.5 rounded-full bg-gold/10 px-3.5 py-1.5 border border-gold/30 text-gold hover:bg-gold/20 transition-colors active:scale-[0.98] font-medium touch-manipulation">
            <span>{isSpanish ? 'Ver todas las ciudades' : 'View All Cities'}</span>
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div data-reveal="scale" class="relative">
      <div class="motion-float-slow overflow-hidden rounded-xl border border-white/8 shadow-lg">
        <CldImage
          src="about-team_aexfzl"
          alt={content.imageAlt}
          width={1280}
          height={900}
          sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 1024px) 90vw, 56vw"
          class="w-full object-cover object-left min-h-96 lg:min-h-136"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/46 via-transparent to-transparent"></div>
      </div>

      <div class="motion-enter absolute left-4 right-4 sm:right-auto sm:left-5 bottom-4 sm:bottom-5 sm:max-w-xs rounded-xl border border-wine-soft/18 bg-[linear-gradient(180deg,rgba(15,16,18,0.78),rgba(79,29,30,0.44))] px-5 py-4 backdrop-blur-md shadow-lg" style="--enter-delay: 260ms">
        <p class="text-xs uppercase tracking-wide text-gold">{content.cardEyebrow}</p>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary">{content.cardDescription}</p>
      </div>
    </div>
  </div>
</section>
