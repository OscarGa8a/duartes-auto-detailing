---
import { CldImage } from "astro-cloudinary";
import { aboutMetricValues, resolveAboutTemplate } from "../../../i18n/about-content";
import type { AboutContent } from "../../../i18n/content-types";

interface Props {
  content: AboutContent["standard"];
}

const { content } = Astro.props;
const isSpanish = content.eyebrow.startsWith("El ");
---

<section class="bg-black py-10 lg:py-16 overflow-hidden relative border-b border-border-soft">
  <div class="motion-drift absolute -left-10 top-10 h-64 w-64 rounded-full bg-gold/10 blur-3xl"></div>
  <div class="motion-drift absolute right-0 bottom-0 h-64 w-64 rounded-full bg-wine/12 blur-3xl" style="--float-delay: 1.1s"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[0.92fr_1.08fr] gap-10 lg:gap-16 items-center">
      <div data-reveal="scale" class="relative order-2 lg:order-1">
        <div class="motion-float-slow overflow-hidden rounded-xl border border-white/8 shadow-lg">
          <CldImage
            src="img5_brw7kv"
            alt={content.imageAlt}
            width={1000}
            height={900}
            sizes="(max-width: 1024px) 100vw, 42vw"
            class="w-full h-full object-cover min-h-96 lg:min-h-136"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/58 via-transparent to-transparent"></div>
        </div>

        <div class="motion-enter absolute left-5 right-5 bottom-5 rounded-xl border border-wine-soft/22 bg-[linear-gradient(180deg,rgba(110,43,44,0.16),rgba(23,24,27,0.9))] px-5 py-4 shadow-lg backdrop-blur-sm" style="--enter-delay: 260ms">
          <p class="text-xs font-semibold uppercase tracking-wide text-gold">{content.calloutEyebrow}</p>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">{content.calloutDescription}</p>
        </div>
      </div>

      <div class="order-1 lg:order-2 flex flex-col gap-6" data-reveal="blur">
        <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold">
          <span class="h-px w-10 bg-gold"></span>
          {content.eyebrow}
        </span>
        <h2 class="text-text-primary font-bold leading-tight text-h1 max-w-2xl">
          {content.title}
        </h2>
        <p class="text-wine-tint font-medium italic">
          {content.highlight}
        </p>
        <p class="text-text-secondary leading-relaxed max-w-2xl">
          {resolveAboutTemplate(content.description)}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div data-reveal="scale" style="--reveal-delay: 280ms" class="motion-card-hover relative overflow-hidden rounded-xl border border-border-soft bg-surface-2 px-5 py-5 text-center">
            <div class="absolute inset-x-5 top-0 h-px bg-linear-to-r from-transparent via-wine-soft/72 to-transparent"></div>
            <div class="motion-glow-pulse absolute -right-6 -top-6 h-20 w-20 rounded-full bg-gold/8 blur-2xl" style="--float-delay: 0.8s"></div>
            <span class="text-gold font-bold text-2xl md:text-3xl" data-count-to={aboutMetricValues.vehiclesDetailed} data-count-suffix="+" data-count-duration="1800">{aboutMetricValues.vehiclesDetailed}+</span>
            <span class="mt-2 block text-sm text-text-secondary">{content.counters[0]}</span>
          </div>

          <div data-reveal="scale" style="--reveal-delay: 180ms" class="motion-card-hover relative overflow-hidden rounded-xl border border-border-soft bg-surface-2 px-5 py-5 text-center">
            <div class="absolute inset-x-5 top-0 h-px bg-linear-to-r from-transparent via-gold/70 to-transparent"></div>
            <div class="motion-glow-pulse absolute -right-6 -top-6 h-20 w-20 rounded-full bg-gold/8 blur-2xl"></div>
            <span class="text-gold font-bold text-2xl md:text-3xl" data-count-to={aboutMetricValues.yearsOfExperience} data-count-suffix="+" data-count-duration="1100">{aboutMetricValues.yearsOfExperience}+</span>
            <span class="mt-2 block text-sm text-text-secondary">{content.counters[1]}</span>
          </div>

          <div data-reveal="scale" style="--reveal-delay: 380ms" class="motion-card-hover relative overflow-hidden rounded-xl border border-border-soft bg-surface-2 px-5 py-5 text-center">
            <div class="absolute inset-x-5 top-0 h-px bg-linear-to-r from-transparent via-wine-soft/72 to-transparent"></div>
            <div class="motion-glow-pulse absolute -right-6 -top-6 h-20 w-20 rounded-full bg-wine/12 blur-2xl" style="--float-delay: 1.2s"></div>
            <span class="text-gold font-bold text-2xl md:text-3xl" data-count-to={aboutMetricValues.bayAreaLocations} data-count-suffix="+" data-count-duration="1600">{aboutMetricValues.bayAreaLocations}+</span>
            <span class="mt-2 block text-sm text-text-secondary">{content.counters[2]}</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-2 text-xs font-medium uppercase tracking-wide text-text-secondary">
          <span class="inline-flex items-center gap-1.5 text-gold">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>{isSpanish ? 'Totalmente asegurado' : 'Fully Insured'}</span>
          </span>
          <span aria-hidden="true" class="size-1 rounded-full bg-gold/60"></span>
          <span>{isSpanish ? 'Servicio a domicilio y oficina' : 'Mobile Home & Office Service'}</span>
          <span aria-hidden="true" class="size-1 rounded-full bg-gold/60"></span>
          <span>{isSpanish ? 'Garantía de satisfacción' : '100% Satisfaction Guarantee'}</span>
        </div>
      </div>
    </div>
  </div>
</section>
