---
import ServiceCard from '../../ui/ServiceCard.astro';
import type { Service } from '../../../data/services';
import type { Locale } from '../../../i18n/locales';
import { spanishServiceDetails } from '../../../i18n/spanish-service-details';

interface Props {
  services: Service[];
  locale?: Locale;
}

const { services, locale = 'en-US' } = Astro.props;

const isSpanish = locale === 'es-US';
const eyebrow = isSpanish ? "Servicios relacionados" : "Related services";
const title = isSpanish ? "También te pueden interesar estos servicios." : "You might also be interested in these services.";
const description = isSpanish
  ? "Si estás comparando opciones, estos servicios relacionados son excelentes alternativas según el acabado, protección o nivel de restauración que buscas."
  : "If you are comparing options, these related services are the next best places to continue depending on the finish, protection, or restoration level you want.";
const buttonText = isSpanish ? "Ver detalles" : "See more details";
---

<section class="bg-off-white py-10 lg:py-16 relative overflow-hidden border-b border-divider-light/70">
  <div class="motion-drift absolute -left-16 top-20 h-60 w-60 rounded-full bg-wine/10 blur-3xl"></div>
  <div class="motion-drift absolute -right-14 bottom-16 h-72 w-72 rounded-full bg-gold/8 blur-3xl" style="--float-delay: 1.1s"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-10">
    <div data-reveal="blur" class="flex flex-col gap-3">
      <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold-deep">
        <span class="h-px w-10 bg-gold"></span>
        {eyebrow}
      </span>
      <h2 class="text-text-dark font-bold text-h2">
        {title}
      </h2>
      <p class="text-text-dark/72 leading-relaxed">
        {description}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service, index) => (
        <div data-reveal="scale" style={`--reveal-delay: ${index * 120}ms; --float-delay: ${index * 0.5}s`} class="motion-float-slow motion-card-hover relative">
          {index === 1 && (
            <div class="pointer-events-none absolute -right-6 -top-6 h-24 w-24 rounded-full bg-wine/10 blur-2xl"></div>
          )}
          <ServiceCard
            image={service.images[0]}
            title={isSpanish ? (spanishServiceDetails[service.id]?.name ?? service.name) : service.name}
            description={isSpanish ? (spanishServiceDetails[service.id]?.tagline ?? service.description) : service.description}
            href={isSpanish ? `/es/services/${service.slug}/` : `/services/${service.slug}`}
            buttonText={buttonText}
          />
        </div>
      ))}
    </div>
  </div>
</section>
