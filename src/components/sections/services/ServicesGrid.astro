---
import { services } from "../../../data/services";
import type { ServicesContent } from "../../../i18n/content-types";
import ServiceCard from "./ServiceCard.astro";

const { content } = Astro.props as { content: ServicesContent };
const englishDetailDisclosure = content.policy.englishDetailDisclosure === "required"
  ? content.cards.englishDetailDisclosure
  : undefined;

if (content.policy.englishDetailDisclosure === "required" && !englishDetailDisclosure) {
  throw new Error("English detail disclosure is required before linking to English-only service details.");
}
---

<section class="relative bg-off-white py-10 lg:py-16 overflow-hidden border-b border-divider-light/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10 relative flex flex-col gap-10">
    <div data-reveal="blur" class="flex flex-col gap-3 text-left">
      <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold-deep">
        <span class="h-px w-10 bg-gold"></span>
        {content.grid.eyebrow}
      </span>
      <h2 class="text-text-dark font-bold text-h2">{content.grid.title}</h2>
      <p class="text-text-dark/72 leading-relaxed">{content.grid.description}</p>
    </div>{englishDetailDisclosure && <p class="text-sm text-text-secondary">{englishDetailDisclosure}</p>}

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service, index) => {
        const presentation = content.cards.byServiceId[service.id];

        return (
          <div data-reveal="scale" style={`--reveal-delay: ${index * 70}ms`} class="relative h-full">
            <ServiceCard
              service={service}
              displayName={presentation.displayName}
              summary={presentation.summary}
              detailAction={content.cards.detailAction}
            />
          </div>
        );
      })}
    </div>
  </div>
</section>
