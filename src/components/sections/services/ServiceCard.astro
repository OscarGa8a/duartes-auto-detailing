---
import { CldImage } from "astro-cloudinary";
import Button from "../../ui/Button.astro";
import type { Service } from "../../../data/services";

interface Props {
  service: Service;
  displayName: string;
  summary: string;
  detailAction: string;
}

const { service, displayName, summary, detailAction } = Astro.props as Props;
const href = `/services/${service.slug}`;

const categoryBadges: Record<string, { en: string; es: string }> = {
  "full-detail": { en: "Signature Package", es: "Paquete Insignia" },
  "ceramic-coating": { en: "Ultra Protection", es: "Protección Cerámica" },
  "paint-correction": { en: "Paint Restoration", es: "Corrección de Pintura" },
  "interior-detail": { en: "Interior Care", es: "Cuidado Interior" },
  "exterior-detail": { en: "Exterior Gloss", es: "Brillo Exterior" },
  "seat-upholstery-deep-cleaning": { en: "Deep Cleaning", es: "Limpieza Profunda" },
  "headlight-restoration": { en: "Restoration", es: "Restauración de Faros" },
  "clay-bar-decontamination": { en: "Decontamination", es: "Descontaminación" },
};

const isSpanish = detailAction.toLowerCase().includes("inglés") || detailAction.toLowerCase().includes("detalles en");
const badge = isSpanish ? categoryBadges[service.id]?.es : categoryBadges[service.id]?.en;
const isFeatured = service.id === "full-detail" || service.id === "ceramic-coating";
---

<article
  class={`group relative rounded-2xl overflow-hidden flex flex-col h-full bg-surface-2 border transition-all duration-300 hover:-translate-y-1.5 ${
    isFeatured
      ? "border-gold/35 shadow-[0_12px_32px_-16px_rgba(212,175,55,0.22)] hover:border-gold/60 hover:shadow-[0_20px_45px_-12px_rgba(212,175,55,0.32)]"
      : "border-white/10 hover:border-gold/40 shadow-lg hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.8)]"
  }`}
>
  <div class="aspect-video relative overflow-hidden bg-black/40">
    <a href={href} tabindex="-1" aria-hidden="true" class="block w-full h-full">
      <CldImage
        src={service.images[0]}
        alt={displayName || service.name}
        width={640}
        height={360}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      />
    </a>
    <div class="absolute inset-0 bg-gradient-to-t from-surface-2 via-transparent to-transparent opacity-70 pointer-events-none"></div>
    {badge && (
      <div class="absolute top-3.5 left-3.5 pointer-events-none">
        <span
          class={`inline-flex items-center px-2.5 py-1 rounded-full text-[0.68rem] font-semibold tracking-wider uppercase backdrop-blur-md ${
            isFeatured
              ? "bg-gold/20 text-gold border border-gold/40 shadow-sm"
              : "bg-black/60 text-text-secondary border border-white/15"
          }`}
        >
          {badge}
        </span>
      </div>
    )}
  </div>
  <div class="p-5 sm:p-6 flex flex-col flex-1">
    <h3 class="font-bold text-lg text-text-primary tracking-tight group-hover:text-gold transition-colors duration-200">
      {displayName}
    </h3>
    <p class="mt-2.5 text-sm leading-relaxed text-text-secondary line-clamp-3 mb-4">
      {summary}
    </p>
    <div class="mt-auto pt-2">
      <Button
        href={href}
        variant="primary-bright"
        class="w-full text-center inline-flex items-center justify-center gap-2 active:scale-[0.98] transition-transform duration-150"
      >
        <span>{detailAction}</span>
        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </Button>
    </div>
  </div>
</article>
