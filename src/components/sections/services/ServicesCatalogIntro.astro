---
import { CldImage } from "astro-cloudinary";
import type { ServicesContent } from "../../../i18n/content-types";

const { content } = Astro.props as { content: ServicesContent["intro"] };
---

<section>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[1.04fr_0.96fr] gap-10 lg:gap-16 items-center">
    <div data-reveal="blur" class="flex flex-col gap-6 max-w-2xl">
      <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold">
        <span class="h-px w-10 bg-gold"></span>
        {content.eyebrow}
      </span>
      <h2 class="text-text-primary font-bold leading-tight text-h1 max-w-xl">
        {content.title}
      </h2>
      <p class="text-text-secondary leading-relaxed max-w-xl">
        {content.description}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-2">
        {content.benefits.map((benefit, index) => (
          <div
            data-reveal="scale"
            style={`--reveal-delay: ${index * 60}ms`}
            class="relative overflow-hidden rounded-xl border border-white/10 bg-surface-2/90 px-4 py-4 text-center transition-all duration-300 hover:border-gold/30 hover:bg-surface-2"
          >
            <div class={`absolute inset-x-4 top-0 h-px bg-linear-to-r from-transparent ${index === 1 ? "via-gold/70" : "via-wine-soft/72"} to-transparent`}></div>
            <span class="block text-gold font-bold text-2xl sm:text-3xl tracking-tight">{benefit.title}</span>
            <span class="mt-1 block text-xs font-medium text-text-secondary leading-snug">{benefit.description}</span>
          </div>
        ))}
      </div>
    </div>

    <div data-reveal="scale" class="relative">
      <div class="overflow-hidden rounded-xl border border-white/8 shadow-lg">
        <CldImage
          src="about-cta_xhm8le"
          alt={content.imageAlt}
          width={1000}
          height={800}
          sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 1024px) 90vw, 44vw"
          class="w-full object-cover min-h-80 sm:min-h-96 lg:min-h-136"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/58 via-transparent to-transparent"></div>
      </div>

      <div
        class="motion-enter absolute left-4 right-4 sm:right-auto sm:left-5 bottom-4 sm:bottom-5 sm:max-w-sm rounded-xl border border-wine-soft/20 bg-[linear-gradient(180deg,rgba(15,16,18,0.85),rgba(79,29,30,0.50))] px-5 py-4 shadow-lg backdrop-blur-md"
        style="--enter-delay: 240ms"
      >
        <p class="text-xs font-semibold uppercase tracking-wider text-gold">{content.processEyebrow}</p>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary">{content.processDescription}</p>
      </div>
    </div>
  </div>
</section>
