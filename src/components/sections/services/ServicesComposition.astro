---
import type { ServicesContent } from "../../../i18n/content-types";
import { englishHomeContent, spanishHomeContent } from "../../../i18n/home-content";
import { servicesSectionPolicies } from "../../../i18n/services-content";
import PageHero from "../../ui/PageHero.astro";
import DiscountBanner from "../home/DiscountBanner.astro";
import ServicesSection from "./ServicesSection.astro";

const { content, locale } = Astro.props as {
  content: ServicesContent;
  locale: keyof typeof servicesSectionPolicies;
};
const promotionPolicy = servicesSectionPolicies[locale];

function getAreaTeaser(servicesContent: ServicesContent): NonNullable<ServicesContent["areaTeaser"]> | undefined {
  if (servicesContent.policy.areaTeaser === "include") {
    const { areaTeaser } = servicesContent;
    if (areaTeaser === undefined) {
      throw new Error("Area teaser is required when the Services policy includes it.");
    }

    return areaTeaser;
  }

  return undefined;
}

const areaTeaserContent = getAreaTeaser(content);
const discountBannerContent = locale === "es-US" ? spanishHomeContent.discountBanner : englishHomeContent.discountBanner;
---

<PageHero
  title={content.hero.title}
  backgroundImage={{ mobile: "banner-services-mobile_a1pwkn", desktop: "banner-services-web_db80lf" }}
  eyebrow={content.hero.eyebrow}
  description={content.hero.description}
/>
<ServicesSection content={content} />
{areaTeaserContent && (
  <section class="bg-off-white py-10 lg:py-16 border-b border-divider-light/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
      <div data-reveal="up" class="flex flex-col gap-3">
        <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold-deep">
          <span class="h-px w-10 bg-gold"></span>
          {areaTeaserContent.eyebrow}
        </span>
        <h2 class="text-text-dark font-bold text-h2">{areaTeaserContent.title}</h2>
        <p class="max-w-3xl text-text-dark/72 leading-relaxed">{areaTeaserContent.description}</p>
      </div>
      <a
        data-reveal="up"
        href={locale === "es-US" ? "/es/service-area/bay-area/" : "/service-area/bay-area/"}
        class="group inline-flex items-center justify-center gap-2 rounded-full bg-black px-6 py-3.5 text-sm font-semibold text-text-primary transition-all duration-200 hover:bg-surface hover:text-gold border border-transparent hover:border-gold/30 active:scale-[0.98] shadow-sm hover:shadow-md w-full sm:w-auto self-start sm:self-auto"
      >
        <span>{areaTeaserContent.action}</span>
        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>
)}
{promotionPolicy.discountBanner === "include" && (
  <DiscountBanner content={discountBannerContent} locale={locale} />
)}
