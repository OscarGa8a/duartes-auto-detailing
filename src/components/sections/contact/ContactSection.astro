---
import ContactForm from "./ContactForm.astro";
import ContactOptions from "./ContactOptions.astro";
import { config } from "../../../data/config";
import type { ContactContent } from "../../../i18n/content-types";

interface Props {
  content: ContactContent;
}

const { content } = Astro.props;
const isSpanish = content.hero.eyebrow === "Contacto";
---

<section class="bg-black py-10 lg:py-16 overflow-hidden relative border-b border-border-soft">
  <div class="motion-drift absolute -left-12 top-14 h-64 w-64 rounded-full bg-gold/10 blur-3xl"></div>
  <div class="motion-drift absolute right-0 bottom-0 h-64 w-64 rounded-full bg-wine/12 blur-3xl" style="--float-delay: 1.2s"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-10 lg:gap-14 lg:items-start">
    <div class="flex flex-col gap-6 lg:gap-10 w-full">
      <div data-reveal="blur" class="flex flex-col gap-4">
        <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold">
          <span class="h-px w-10 bg-gold"></span>
          {content.section.eyebrow}
        </span>
        <h2 class="text-text-primary font-bold text-h1">
          {content.section.title}
        </h2>
        <p class="text-text-secondary leading-relaxed">
          {content.section.description}
        </p>
      </div>

      <ContactOptions content={content.channels} />

      <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-white/8 bg-surface/70 px-5 py-4 backdrop-blur-sm">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-medium uppercase tracking-wide text-text-secondary">
          <span class="inline-flex items-center gap-1.5 text-gold">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{isSpanish ? 'Lun - Dom: 6:00 AM - 8:00 PM' : 'Mon - Sun: 6:00 AM - 8:00 PM'}</span>
          </span>
          <span aria-hidden="true" class="size-1 rounded-full bg-gold/60"></span>
          <span>{isSpanish ? 'Totalmente asegurado' : 'Fully Insured'}</span>
          <span aria-hidden="true" class="size-1 rounded-full bg-gold/60"></span>
          <span>{isSpanish ? 'Detallado 100% móvil' : '100% Mobile Service'}</span>
        </div>

        <a
          href={`tel:${config.phoneUSE164}`}
          class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-gold hover:text-gold/80 transition-colors active:scale-[0.98]"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>{config.phoneFormatted}</span>
        </a>
      </div>

      <div class="flex flex-col gap-2.5">
        <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">
          {isSpanish ? 'Áreas de servicio en la Bay Area' : 'Bay Area Service Locations'}
        </span>
        <div class="flex flex-wrap gap-2 text-xs text-text-secondary">
          <a href="/service-area/san-jose/" class="rounded-full bg-white/4 px-3 py-1 border border-white/8 hover:border-gold/40 hover:text-gold transition-colors active:scale-[0.98]">San Jose</a>
          <a href="/service-area/san-francisco/" class="rounded-full bg-white/4 px-3 py-1 border border-white/8 hover:border-gold/40 hover:text-gold transition-colors active:scale-[0.98]">San Francisco</a>
          <a href="/service-area/oakland/" class="rounded-full bg-white/4 px-3 py-1 border border-white/8 hover:border-gold/40 hover:text-gold transition-colors active:scale-[0.98]">Oakland</a>
          <a href="/service-area/fremont/" class="rounded-full bg-white/4 px-3 py-1 border border-white/8 hover:border-gold/40 hover:text-gold transition-colors active:scale-[0.98]">Fremont</a>
          <a href="/service-area/berkeley/" class="rounded-full bg-white/4 px-3 py-1 border border-white/8 hover:border-gold/40 hover:text-gold transition-colors active:scale-[0.98]">Berkeley</a>
          <a href="/service-area/walnut-creek/" class="rounded-full bg-white/4 px-3 py-1 border border-white/8 hover:border-gold/40 hover:text-gold transition-colors active:scale-[0.98]">Walnut Creek</a>
          <a href="/service-area/bay-area/" class="inline-flex items-center gap-1 rounded-full bg-gold/10 px-3 py-1 border border-gold/30 text-gold hover:bg-gold/20 transition-colors active:scale-[0.98] font-medium">
            <span>{isSpanish ? 'Ver todas las ciudades' : 'View All Cities'}</span>
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="flex justify-center w-full">
      <ContactForm content={content.form} />
    </div>
  </div>
</section>
