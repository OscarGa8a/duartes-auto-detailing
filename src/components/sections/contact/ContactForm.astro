---
import Button from "../../ui/Button.astro";
import Icon from "../../ui/Icon.astro";
import type { ContactContent } from "../../../i18n/content-types";

interface Props {
  content: ContactContent["form"];
}

const { content } = Astro.props;
---

<div data-reveal="blur" class="relative overflow-hidden rounded-xl border border-wine-soft/18 bg-[linear-gradient(180deg,rgba(110,43,44,0.12),rgba(23,24,27,0.98))] p-6 sm:p-8 lg:p-10 shadow-lg">
  <div class="motion-sheen"></div>
  <div class="motion-glow-pulse absolute -right-10 -top-10 h-28 w-28 rounded-full bg-wine/14 blur-2xl"></div>

  <div class="relative z-10 flex flex-col gap-8">
    <div class="flex flex-col gap-4">
      <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold">
        <span class="h-px w-10 bg-gold"></span>
        {content.eyebrow}
      </span>
      <h2 class="text-text-primary font-bold text-h2 max-w-xl">
        {content.title}
      </h2>
      <p class="text-text-secondary leading-relaxed max-w-xl">
        {content.description}
      </p>
    </div>

    <form id="contact-form" novalidate class="w-full flex flex-col gap-5">

      <!-- Honeypot (hidden from humans, visible to bots) -->
      <div style="position: absolute; left: -9999px;" aria-hidden="true">
        <label for="website">{content.honeypotLabel}</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <!-- Row: Nombre + Email + Teléfono -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="flex flex-col gap-1">
          <label for="name" class="sr-only">{content.fields.name.label}</label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder={content.fields.name.placeholder}
            aria-required="true"
            aria-describedby="name-error"
            class="contact-input rounded-xl bg-black/26 border border-white/12 hover:border-white/25 text-text-primary placeholder:text-text-muted px-4 py-3 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold/50 focus:bg-black/36 transition-[border-color,background-color,box-shadow] duration-200 w-full"
          />
          <span class="error-msg text-red-400 text-xs hidden" id="name-error">{content.fields.name.error}</span>
        </div>

        <div class="flex flex-col gap-1">
          <label for="email" class="sr-only">{content.fields.email.label}</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder={content.fields.email.placeholder}
            aria-required="true"
            aria-describedby="email-error"
            class="contact-input rounded-xl bg-black/26 border border-white/12 hover:border-white/25 text-text-primary placeholder:text-text-muted px-4 py-3 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold/50 focus:bg-black/36 transition-[border-color,background-color,box-shadow] duration-200 w-full"
          />
          <span class="error-msg text-red-400 text-xs hidden" id="email-error">{content.fields.email.error}</span>
        </div>

        <div class="flex flex-col gap-1">
          <label for="phone" class="sr-only">{content.fields.phone.label}</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            placeholder={content.fields.phone.placeholder}
            aria-required="true"
            aria-describedby="phone-error"
            class="contact-input rounded-xl bg-black/26 border border-white/12 hover:border-white/25 text-text-primary placeholder:text-text-muted px-4 py-3 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold/50 focus:bg-black/36 transition-[border-color,background-color,box-shadow] duration-200 w-full"
          />
          <span class="error-msg text-red-400 text-xs hidden" id="phone-error">{content.fields.phone.error}</span>
        </div>
      </div>

      <!-- Mensaje -->
      <div class="flex flex-col gap-1">
        <label for="message" class="sr-only">{content.fields.message.label}</label>
        <textarea
          id="message"
          name="message"
          placeholder={content.fields.message.placeholder}
          rows="4"
          aria-required="true"
          aria-describedby="message-error"
          class="contact-input rounded-xl bg-black/26 border border-white/12 hover:border-white/25 text-text-primary placeholder:text-text-muted px-4 py-3 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold/50 focus:bg-black/36 transition-[border-color,background-color,box-shadow] duration-200 w-full resize-none min-h-40"
        ></textarea>
        <span class="error-msg text-red-400 text-xs hidden" id="message-error">{content.fields.message.error}</span>
      </div>

      <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm leading-relaxed text-wine-tint/80 max-w-sm">
          {content.help}
        </p>

        <Button variant="primary-bright" type="submit">
          {content.submitLabel}
          <Icon name="tabler:mail-forward" />
        </Button>
      </div>

      <div id="success-msg" role="status" aria-live="polite" class="hidden text-center text-green-300 font-medium py-4 rounded-xl bg-green-400/10 border border-green-400/20">
        {content.preparedStatus}
      </div>
    </form>
  </div>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;

  function showError(inputId: string, errorId: string) {
    const input = document.getElementById(inputId) as HTMLInputElement | HTMLTextAreaElement | null;
    const error = document.getElementById(errorId) as HTMLElement | null;
    if (!input || !error) return;
    input.classList.add('border-red-500');
    input.classList.remove('border-border');
    input.setAttribute('aria-invalid', 'true');
    error.classList.remove('hidden');
  }

  function clearError(inputId: string, errorId: string) {
    const input = document.getElementById(inputId) as HTMLInputElement | HTMLTextAreaElement | null;
    const error = document.getElementById(errorId) as HTMLElement | null;
    if (!input || !error) return;
    input.classList.remove('border-red-500');
    input.classList.add('border-border');
    input.removeAttribute('aria-invalid');
    error.classList.add('hidden');
  }

  // Clear errors on input
  ['name', 'email', 'phone', 'message'].forEach((field) => {
    document.getElementById(field)?.addEventListener('input', () => clearError(field, `${field}-error`));
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    // Honeypot check
    const honeypot = document.getElementById('website') as HTMLInputElement;
    if (honeypot.value !== '') return;

    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
    const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    let valid = true;

    if (!name) { showError('name', 'name-error'); valid = false; }
    if (!email || !emailRegex.test(email)) { showError('email', 'email-error'); valid = false; }
    if (!phone) { showError('phone', 'phone-error'); valid = false; }
    if (!message) { showError('message', 'message-error'); valid = false; }

    if (!valid) return;

    // Show prepared status; submission has no delivery backend.
    const successMsg = document.getElementById('success-msg');
    successMsg?.classList.remove('hidden');
    setTimeout(() => successMsg?.classList.add('hidden'), 5000);
  });
</script>
