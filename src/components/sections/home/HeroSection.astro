---
import { socialNetworks } from '../../../data/social-networks';
import { CldImage } from 'astro-cloudinary';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import { config, formattedNumber } from '../../../data/config';
import type { HomeContent } from '../../../i18n/content-types';
import type { Locale } from '../../../i18n/locales';
import { getCanonicalPagePath } from '../../../i18n/routes';

const { content, locale = "en-US" } = Astro.props as { content: HomeContent['hero']; locale?: Locale };
const contactHref = getCanonicalPagePath("contact", locale);
const servicesHref = getCanonicalPagePath("services", locale);

interface HeroSlide {
  srcWeb: string;
  srcMobile: string;
  alt: string;
  mobilePosition: string;
  desktopPosition: string;
}

const heroSlides: HeroSlide[] = [
  {
    srcWeb: 'hero-image-web1_fcezqo',
    srcMobile: 'hero-image-mobile1_ujrqjh',
    alt: content.imageAlts[0],
    mobilePosition: 'object-bottom',
    desktopPosition: 'object-right',
  },
  {
    srcWeb: 'hero-image-web2_uhykzx',
    srcMobile: 'hero-image-mobile2_tc5j8m',
    alt: content.imageAlts[1],
    mobilePosition: 'object-bottom',
    desktopPosition: 'object-right',
  },
  {
    srcWeb: 'hero-image-web3_knxbsn',
    srcMobile: 'hero-image-mobile3_uxdgnl',
    alt: content.imageAlts[2],
    mobilePosition: 'object-bottom',
    desktopPosition: 'object-right',
  },
  {
    srcWeb: 'hero-image-web4_pvhdsi',
    srcMobile: 'hero-image-mobile4_resultado_hmdjwp',
    alt: content.imageAlts[3],
    mobilePosition: 'object-bottom',
    desktopPosition: 'object-right',
  },
].filter((slide) => slide.srcWeb && slide.srcMobile);
---

<section class="relative isolate min-h-screen lg:min-h-[100dvh] overflow-hidden border-b border-border-soft bg-black">
  <div class="absolute inset-0 lg:hidden">
    <div class="embla h-full" id="hero-mobile-embla">
      <div class="embla__viewport h-full overflow-hidden" id="hero-mobile-viewport">
        <div class="embla__container flex h-full">
          {heroSlides.map((slide, index) => (
            <div class="hero-mobile__slide relative h-full overflow-hidden opacity-50">
              <CldImage
                src={slide.srcMobile}
                alt={slide.alt}
                width={900}
                height={1200}
                sizes="(max-width: 1023px) 100vw, 1px"
                fetchpriority={index === 0 ? 'high' : undefined}
                loading={index === 0 ? 'eager' : 'lazy'}
                class={`hero-mobile__image h-full w-full object-cover ${slide.mobilePosition}`}
              />
              <div class="absolute inset-0 bg-black/22"></div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(15,16,18,0.34)_0%,rgba(15,16,18,0.58)_32%,rgba(15,16,18,0.9)_70%,rgba(15,16,18,0.98)_100%)] opacity-20"></div>
  </div>

  <div class="absolute inset-0 hidden lg:block">
    <div class="embla h-full w-full" id="hero-desktop-embla">
      <div class="embla__viewport h-full overflow-hidden" id="hero-desktop-viewport">
        <div class="embla__container flex h-full">
          {heroSlides.map((slide, index) => (
            <div class="hero-desktop__slide relative h-full overflow-hidden">
              <CldImage
                src={slide.srcWeb}
                alt={slide.alt}
                width={2000}
                height={1400}
                sizes="(min-width: 1024px) 100vw, 1px"
                fetchpriority={index === 0 ? 'high' : undefined}
                loading={index === 0 ? 'eager' : 'lazy'}
                class={`hero-desktop__image h-full w-full object-cover ${slide.desktopPosition}`}
              />
              <div class="absolute inset-0 bg-black/22"></div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(15,16,18,0.96)_0%,rgba(15,16,18,0.9)_24%,rgba(15,16,18,0.74)_42%,rgba(15,16,18,0.44)_60%,rgba(15,16,18,0.54)_100%),linear-gradient(180deg,rgba(15,16,18,0.16)_0%,rgba(15,16,18,0.56)_100%)] opacity-50"></div>
  </div>

  <div class="relative z-10 flex min-h-screen lg:min-h-[100dvh] flex-col px-4 pb-6 pt-20 sm:px-6 sm:pt-24 lg:px-24 lg:pt-28 lg:pb-16">
    <div class="mt-auto flex w-full max-w-2xl flex-col gap-4 pb-1 sm:gap-5 lg:my-auto lg:gap-5 lg:pb-0">
      <span class="motion-enter inline-flex w-fit items-center rounded-full border border-gold/30 bg-black/28 px-3.5 py-1.5 text-xxs font-semibold uppercase tracking-wise text-text-secondary shadow-lg backdrop-blur-md lg:bg-surface/72 lg:text-xs lg:tracking-wide lg:backdrop-blur-sm">
        {content.eyebrow}
      </span>

      <h1 class="motion-enter max-w-80 text-balance text-h1 font-bold leading-[1.03] text-text-primary drop-shadow-[0_12px_36px_rgba(0,0,0,0.45)] lg:max-w-2xl lg:text-display lg:drop-shadow-none" style="--enter-delay: 180ms">
        {content.heading[0]}<br />
        <span class="text-gold">{content.heading[1]}</span>
      </h1>

      <p class="motion-enter max-w-88 text-body leading-relaxed text-text-secondary drop-shadow-[0_8px_28px_rgba(0,0,0,0.35)] lg:max-w-lg lg:text-lg lg:drop-shadow-none" style="--enter-delay: 260ms">
        {content.description}
      </p>

      <div class="motion-enter flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-semibold uppercase tracking-wider text-text-secondary drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]" style="--enter-delay: 340ms">
        <span class="text-text-primary/95">{formattedNumber(config.vehiclesDetailed)}+ {content.vehiclesDetailed}</span>
        <span aria-hidden="true" class="size-1.5 rounded-full bg-gold shadow-[0_0_6px_rgba(212,175,55,0.6)]"></span>
        <span class="text-text-primary/95">{locale === 'es-US' ? 'Totalmente asegurado' : 'Fully Insured'}</span>
        <span aria-hidden="true" class="size-1.5 rounded-full bg-gold shadow-[0_0_6px_rgba(212,175,55,0.6)]"></span>
        <span class="lg:hidden text-text-primary/95">{content.mobileService}</span>
        <span class="hidden lg:inline text-text-primary/95">{content.desktopService}</span>
      </div>

      <div class="motion-enter flex flex-col gap-3 pt-1 sm:flex-row lg:gap-4 lg:pt-2" style="--enter-delay: 420ms">
        <Button class="w-full" href={contactHref} variant="primary-bright">
          <Icon name="tabler:phone" />
          {content.primaryAction}
        </Button>
        <Button class="w-full border-gold bg-black/22 text-text-primary backdrop-blur-md hover:bg-black/36" href={servicesHref} variant="outline">
          {content.secondaryAction}
        </Button>
      </div>

      <div class="motion-enter flex items-center justify-between gap-4 pt-2 lg:hidden" style="--enter-delay: 520ms">
        <div id="hero-mobile-dots" class="flex items-center gap-2">
          {heroSlides.map((_, index) => (
            <button type="button" aria-label={`${content.carousel.mobileSlide} ${index + 1}`} class="h-2 w-6 rounded-full bg-white/24 transition-all duration-300 touch-manipulation cursor-pointer" data-index={index}></button>
          ))}
        </div>
        <div class="inline-flex items-center rounded-full border border-white/16 bg-black/28 px-3.5 py-1.5 text-xxs font-semibold uppercase tracking-wide text-text-primary backdrop-blur-md">
          {content.location}
        </div>
      </div>
    </div>

    <div class="motion-enter absolute bottom-8 right-8 hidden items-end gap-5 lg:flex" style="--enter-delay: 560ms">
      <div id="hero-desktop-dots" class="flex items-center gap-2 rounded-full border border-white/12 bg-black/34 px-3 py-2 backdrop-blur-md">
        {heroSlides.map((_, index) => (
          <button type="button" aria-label={`${content.carousel.desktopSlide} ${index + 1}`} class="h-2 w-6 rounded-full bg-white/24 transition-all duration-300 touch-manipulation cursor-pointer" data-index={index}></button>
        ))}
      </div>
      <ul class="flex items-center gap-3">
        {socialNetworks.map(({ name, href, accessibleLabel }) => (
          <li class="motion-card-hover motion-glow-pulse rounded-full border border-gold/20 bg-surface-2/92 p-2.5 transition-colors hover:border-gold/50 hover:bg-surface-3" style="--float-delay: 0.8s">
            <a href={href} target="_blank" rel="noopener noreferrer" aria-label={accessibleLabel} class="text-gold">
              <Icon name={name} size="xl" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero-mobile__slide {
    flex: 0 0 100%;
    min-width: 0;
  }

  .hero-mobile__image {
    animation: hero-mobile-pan 13s ease-in-out infinite;
  }

  .hero-desktop__slide {
    flex: 0 0 100%;
    min-width: 0;
  }

  .hero-desktop__image {
    animation: hero-desktop-pan 14s ease-in-out infinite;
  }

  #hero-mobile-embla,
  #hero-mobile-viewport,
  #hero-mobile-embla .embla__container,
  .hero-mobile__slide,
  #hero-desktop-embla,
  #hero-desktop-viewport,
  #hero-desktop-embla .embla__container,
  .hero-desktop__slide {
    height: 100%;
  }

  @keyframes hero-mobile-pan {
    0%,
    100% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.08);
    }
  }

  @keyframes hero-desktop-pan {
    0%,
    100% {
      transform: scale(1.02);
    }

    50% {
      transform: scale(1.09);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mobile__image,
    .hero-desktop__image {
      animation: none;
    }
  }
</style>

<script>
  import type { EmblaCarouselType } from 'embla-carousel';
  import EmblaCarousel from 'embla-carousel';
  import Autoplay from 'embla-carousel-autoplay';

  function initHeroCarousel(viewportId: string, dotsSelector: string) {
    const viewport = document.getElementById(viewportId);
    const dots = document.querySelectorAll<HTMLButtonElement>(dotsSelector);

    if (!viewport || viewport.dataset.emblaReady === 'true' || viewport.getClientRects().length === 0) {
      return null;
    }

    const autoplay = Autoplay({
      delay: 5200,
      stopOnInteraction: false,
      stopOnMouseEnter: false,
    });

    const embla = EmblaCarousel(
      viewport,
      {
        loop: true,
        align: 'start',
        startIndex: 0,
      },
      [autoplay]
    );

    viewport.dataset.emblaReady = 'true';

    function updateDots() {
      const selected = embla.selectedScrollSnap();

      dots.forEach((dot, index) => {
        dot.classList.toggle('bg-gold', index === selected);
        dot.classList.toggle('w-10', index === selected);
        dot.classList.toggle('bg-white/24', index !== selected);
        dot.classList.toggle('w-6', index !== selected);
        dot.setAttribute('aria-current', index === selected ? 'true' : 'false');
      });
    }

    window.setTimeout(() => {
      embla.scrollTo(0, true);
      updateDots();
    }, 60);

    embla.on('select', updateDots);
    embla.on('reInit', updateDots);

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => embla.scrollTo(index));
    });

    return { embla, viewport };
  }

  function initHeroCarousels() {
    const instances = [] as Array<{ embla: EmblaCarouselType; viewport: HTMLElement }>;
    const mobileInstance = initHeroCarousel('hero-mobile-viewport', '#hero-mobile-dots button');
    const desktopInstance = initHeroCarousel('hero-desktop-viewport', '#hero-desktop-dots button');

    if (mobileInstance) instances.push(mobileInstance);
    if (desktopInstance) instances.push(desktopInstance);

    document.addEventListener(
      'astro:before-preparation',
      () => {
        instances.forEach((instance) => {
          instance.viewport.dataset.emblaReady = 'false';
          instance.embla.destroy();
        });
      },
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initHeroCarousels);
</script>
