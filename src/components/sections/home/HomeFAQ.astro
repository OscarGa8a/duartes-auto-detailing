---
import { config } from '../../../data/config';
import type { HomeFaqItem } from '../../../data/home-faqs';
import type { Locale } from '../../../i18n/locales';

interface Props {
  faqs: readonly HomeFaqItem[];
  locale?: Locale;
}

const { faqs, locale = "en-US" } = Astro.props;

const isSpanish = locale === "es-US";

const copy = isSpanish
  ? {
      eyebrow: "Preguntas frecuentes",
      title: "Preguntas Frecuentes",
      description:
        "Todo lo que necesitas saber sobre nuestro servicio móvil de detallado, áreas de cobertura en el Área de la Bahía y cómo preparar tu vehículo.",
      cardTitle: "Cobertura en el Área de la Bahía",
      cardDescription:
        "Llevamos unidades móviles equipadas directamente a tu hogar, oficina o garaje privado en más de 17 ciudades del Área de la Bahía.",
      cardLink: "Ver todas las zonas",
    }
  : {
      eyebrow: "Common Questions",
      title: "Frequently Asked Questions",
      description:
        "Everything you need to know about our fully mobile detailing service, Bay Area service areas, and appointment preparation.",
      cardTitle: "Bay Area Service Coverage",
      cardDescription:
        "We bring self-contained mobile units directly to your home, office, or private garage across 17+ cities in the Bay Area.",
      cardLink: "Explore All Areas",
    };
---

<section class="bg-black py-12 lg:py-20 border-b border-border-soft relative overflow-hidden">
  <div class="motion-drift absolute -left-16 top-20 h-72 w-72 rounded-full bg-gold/10 blur-3xl"></div>
  <div class="motion-drift absolute right-0 bottom-10 h-72 w-72 rounded-full bg-wine/12 blur-3xl" style="--float-delay: 1.5s"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16 items-start">
      <!-- Left Column: Section Intro & Helpful Resource Card -->
      <div data-reveal="blur" class="flex flex-col gap-6">
        <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold">
          <span class="h-px w-10 bg-gold"></span>
          {copy.eyebrow}
        </span>

        <h2 class="text-h2 font-bold text-text-primary leading-tight">
          {copy.title}
        </h2>

        <p class="text-text-secondary leading-relaxed max-w-md">
          {copy.description}
        </p>

        <!-- Service Area & Assistance Card -->
        <div class="mt-2 rounded-2xl border border-gold/16 bg-[linear-gradient(180deg,rgba(30,32,36,0.96),rgba(79,29,30,0.22))] p-6 shadow-lg">
          <h3 class="text-base font-bold text-text-primary">
            {copy.cardTitle}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">
            {copy.cardDescription}
          </p>
          <div class="mt-3 inline-flex items-center gap-2 text-xs font-semibold text-gold">
            <svg class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>{isSpanish ? 'Totalmente asegurado · Paquetes desde $199' : 'Fully Insured · Packages from $199'}</span>
          </div>
          <div class="mt-4 flex flex-wrap gap-2 pt-2 border-t border-white/6 text-xs text-text-secondary">
            {[
              { name: "San Jose", slug: "san-jose" },
              { name: "San Francisco", slug: "san-francisco" },
              { name: "Oakland", slug: "oakland" },
              { name: "Fremont", slug: "fremont" },
              { name: "Berkeley", slug: "berkeley" },
              { name: "Walnut Creek", slug: "walnut-creek" },
            ].map((city) => (
              <a
                href={isSpanish ? `/es/service-area/${city.slug}/` : `/service-area/${city.slug}/`}
                class="rounded-full bg-white/4 px-2.5 py-1 border border-white/8 hover:border-gold/40 hover:text-gold transition-colors active:scale-[0.98]"
              >
                {city.name}
              </a>
            ))}
          </div>
          <div class="mt-5 flex items-center justify-between">
            <a
              href={isSpanish ? "/es/service-area/bay-area/" : "/service-area/bay-area/"}
              class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-gold hover:text-gold/80 active:scale-[0.98] transition-all"
            >
              <span>{copy.cardLink}</span>
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <a
              href={`tel:${config.phoneUSE164}`}
              class="text-xs font-medium text-text-secondary hover:text-gold transition-colors"
            >
              {config.phoneFormatted}
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Accordion List -->
      <div data-reveal="up" style="--reveal-delay: 100ms" class="flex flex-col gap-4">
        {faqs.map((faq) => (
          <details class="faq-item group rounded-2xl border border-white/8 bg-surface/70 hover:border-gold/30 transition-[border-color,background-color] duration-200 ease-out p-5 lg:p-6 backdrop-blur-sm">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 text-base lg:text-lg font-semibold text-text-primary group-hover:text-gold transition-colors active:scale-[0.99] select-none">
              <span>{faq.question}</span>
              <span class="faq-icon ml-2 flex-shrink-0 text-gold/70 group-hover:text-gold transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="faq-content">
              <div class="faq-content-inner">
                <p class="pt-3 text-sm lg:text-base leading-relaxed text-text-secondary">{faq.answer}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 200ms cubic-bezier(0.4, 0, 1, 1);
  }

  .faq-content-inner {
    overflow: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 160ms ease-in,
      transform 200ms cubic-bezier(0.4, 0, 1, 1);
  }

  /* Expanding: 260ms natural deceleration with staggered opacity */
  details[open]:not(.is-closing) .faq-content {
    grid-template-rows: 1fr;
    transition: grid-template-rows 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  details[open]:not(.is-closing) .faq-content-inner {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 220ms ease-out 40ms,
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Chevron rotation */
  details[open]:not(.is-closing) .faq-icon {
    transform: rotate(180deg);
  }

  details.is-closing .faq-icon {
    transform: rotate(0deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-content,
    .faq-content-inner,
    .faq-icon {
      transition: none !important;
    }
  }
</style>

<script>
  function setupFaqAccordions() {
    const detailsList = document.querySelectorAll<HTMLDetailsElement>('details.faq-item');

    detailsList.forEach((detail) => {
      const summary = detail.querySelector('summary');
      const content = detail.querySelector('.faq-content');
      if (!summary || !content) return;

      summary.addEventListener('click', (event) => {
        if (detail.classList.contains('is-closing')) {
          event.preventDefault();
          return;
        }

        if (detail.open) {
          event.preventDefault();
          detail.classList.add('is-closing');

          setTimeout(() => {
            detail.removeAttribute('open');
            detail.classList.remove('is-closing');
          }, 210);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupFaqAccordions);
  setupFaqAccordions();
</script>
