---
import { localeDefinitions, type Locale } from "../../i18n/locales";
import { getPublishedCounterpart, getShellDestinationPath, resolveCounterpartPath, type PageId, type RoutePath } from "../../i18n/routes";
import type { ShellContent } from "../../i18n/content-types";
import Icon from "../ui/Icon.astro";

interface Props {
  content: ShellContent;
  locale?: Locale;
  pageId?: PageId;
}

const { content, locale = "en-US", pageId } = Astro.props;
let counterpart = getPublishedCounterpart(pageId, locale);
if (counterpart) {
  counterpart = {
    ...counterpart,
    path: resolveCounterpartPath(counterpart.path, Astro.url.pathname) as RoutePath,
  };
}
const languageControlLabel = `${content.languageControl.label}: ${content.languageControl.destinationLabel}`;
const logoHref = getShellDestinationPath("home", locale);
const navigationIcons: Record<PageId, string> = {
  home: "tabler:home",
  about: "tabler:info-circle",
  services: "tabler:sparkles",
  contact: "tabler:phone",
};

const normalizePath = (path: string) => {
  if (!path || path === '/') return '/';
  return path.replace(/\/+$/, '');
};

const currentPath = normalizePath(Astro.url.pathname);
const homeHref = normalizePath(getShellDestinationPath("home", locale));

const isLinkActive = (href: string, itemPageId?: PageId) => {
  if (currentPath.includes('/service-area/')) {
    return false;
  }

  if (pageId && itemPageId) {
    return pageId === itemPageId;
  }

  const normalizedHref = normalizePath(href);

  if (normalizedHref === homeHref || normalizedHref === '/') {
    return currentPath === normalizedHref;
  }

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};

const links = content.navigation.map(({ pageId: itemPageId, label }) => ({
  pageId: itemPageId,
  href: getShellDestinationPath(itemPageId, locale),
  label,
  icon: navigationIcons[itemPageId],
}));
---

<header
  id="site-header"
  data-scrolled="false"
  class="site-header fixed top-0 inset-x-0 z-50"
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 md:h-20">
    <!-- Logo -->
    <a href={logoHref} class="flex items-center gap-2 shrink-0">
      <picture class="contents">
        <source srcset="/images/logo.webp" type="image/webp" />
        <img
          src="/images/logo.png"
          alt={content.brandLogoAlt}
          width="226"
          height="67"
          class="h-10! md:h-15! w-auto object-contain"
          loading="eager"
          decoding="async"
        />
      </picture>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-8">
      {links.map(({ href, label, pageId: itemPageId }) => (
        <li>
          <a
            href={href}
            class={`text-sm font-medium transition-colors hover:text-gold drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)] ${
              isLinkActive(href, itemPageId) ? 'text-gold' : 'text-white'
            }`}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    {counterpart && (
      <a
        href={counterpart.path}
        hreflang={localeDefinitions[counterpart.locale].htmlLang}
        aria-label={languageControlLabel}
        class="hidden md:inline-flex text-sm font-medium text-white transition-colors hover:text-gold drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]"
      >
        {content.languageControl.destinationLabel}
      </a>
    )}

    <!-- Mobile hamburger -->
    <button
      id="hamburger"
      aria-label={content.menu.openLabel}
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden inline-flex h-11 w-11 items-center justify-center rounded-full border border-gold/18 bg-[linear-gradient(180deg,rgba(30,32,36,0.96),rgba(79,29,30,0.34))] text-text-primary shadow-[0_18px_28px_-22px_rgba(110,43,44,0.7)] transition-all duration-300 hover:border-wine-soft/55 hover:bg-[linear-gradient(180deg,rgba(38,41,46,1),rgba(110,43,44,0.42))] hover:text-gold"
    >
      <Icon name="tabler:menu-2" size="xl" class="text-current" />
    </button>
  </nav>

  <!-- Mobile overlay menu -->
  <div
    id="mobile-menu"
    data-open="false"
    aria-hidden="true"
    inert
    class="fixed inset-0 z-50 md:hidden pointer-events-none"
  >
    <button
      id="mobile-menu-backdrop"
      aria-label={content.menu.closeLabel}
      class="absolute inset-0 bg-[linear-gradient(180deg,rgba(15,16,18,0.78),rgba(79,29,30,0.48))] opacity-0 backdrop-blur-sm transition-opacity duration-300"
    ></button>

    <div
      id="mobile-menu-panel"
      class="absolute top-0 opacity-0 min-h-dvh w-full flex items-center justify-center rounded-xl"
    >
      <div class="overflow-hidden rounded-xl border border-wine-soft/18 bg-[linear-gradient(180deg,rgba(30,32,36,0.99),rgba(23,24,27,0.98))] px-5 pb-6 pt-5 shadow-[0_30px_70px_-36px_rgba(0,0,0,0.98)] scale-[0.985] transition-all duration-300">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(212,175,55,0.12),transparent_30%),radial-gradient(circle_at_bottom_right,rgba(110,43,44,0.24),transparent_32%)]"></div>
        <div class="motion-drift absolute -left-8 top-0 h-32 w-32 rounded-full bg-gold/10 blur-3xl"></div>
        <div class="motion-drift absolute right-0 bottom-0 h-28 w-28 rounded-full bg-wine/16 blur-3xl" style="--float-delay: 1s"></div>
  
        <div class="relative z-10 flex items-start justify-between gap-4 border-b border-white/8 pb-4">
          <div class="flex flex-col gap-2">
            <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold">
              <span class="h-px w-8 bg-gold"></span>
              {content.menu.heading}
            </span>
            <p class="max-w-56 text-sm leading-relaxed text-text-secondary">
              {content.menu.subtitle}
            </p>
          </div>
  
          <button
            id="close-menu"
            aria-label={content.menu.closeLabel}
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-black/26 text-text-primary transition-colors duration-300 hover:border-wine-soft/45 hover:bg-wine/12 hover:text-wine-tint"
          >
            <Icon name="tabler:x" size="xl" class="text-current" />
          </button>
        </div>
  
        <ul class="relative z-10 mt-5 flex flex-col gap-3">
        {links.map(({ href, label, icon, pageId: itemPageId }, index) => {
          const isActive = isLinkActive(href, itemPageId);
          return (
            <li data-menu-item style={`--menu-delay: ${index * 70}ms`}>
              <a
                href={href}
                class={`group flex items-center justify-between gap-4 rounded-xl border px-4 py-4 transition-all duration-300 ${
                    isActive
                    ? 'border-wine-soft/34 bg-[linear-gradient(90deg,rgba(110,43,44,0.22),rgba(212,175,55,0.08))] text-gold shadow-[0_18px_30px_-24px_rgba(110,43,44,0.5)]'
                    : 'border-white/8 bg-black/20 text-text-primary hover:border-wine-soft/24 hover:bg-wine/10'
                }`}
              >
                <div class="flex items-center gap-4">
                  <span class={`inline-flex h-11 w-11 items-center justify-center rounded-full ${
                    isActive ? 'bg-gold text-text-dark' : 'bg-[linear-gradient(180deg,rgba(38,41,46,1),rgba(110,43,44,0.3))] text-gold'
                  }`}>
                    <Icon name={icon} size="lg" class="text-current" />
                  </span>
                    <div class="flex flex-col gap-1">
                      <span class="text-lg font-semibold">{label}</span>
                      <span class="text-xs font-medium uppercase tracking-wide text-text-muted">
                        {isActive ? content.menu.currentPageLabel : content.menu.openSectionLabel}
                      </span>
                    </div>
                  </div>
                </a>
              </li>
          );
        })}
        </ul>
  
        <!-- <div class="relative z-10 mt-5 rounded-[1.35rem] border border-gold/16 bg-gold/10 px-4 py-4">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-gold">Need a faster quote?</p>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">
            Open the contact page and start your booking with the channel that feels easiest for you.
          </p>
          <a
            href="/contact"
            class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-full bg-linear-to-b from-gold via-[#D4AF37] to-gold-dark px-5 py-3 text-sm font-semibold text-text-dark shadow-lg transition-all duration-300 hover:from-[#FFE082] hover:via-[#E0BC4A] hover:to-[#C89B1E]"
          >
            <Icon name="tabler:phone" size="sm" />
            Book a premium service
          </a>
        </div> -->
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: linear-gradient(180deg, rgba(15, 16, 18, 0.92) 0%, rgba(15, 16, 18, 0.6) 55%, transparent 100%);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    transition:
      background 320ms cubic-bezier(0.4, 0, 0.2, 1),
      backdrop-filter 320ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-header[data-scrolled='true'] {
    background: rgba(15, 16, 18, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.7);
  }

  #mobile-menu[data-open='true'] {
    pointer-events: auto;
  }

  #mobile-menu[data-open='true'] #mobile-menu-backdrop {
    opacity: 1;
  }

  #mobile-menu[data-open='true'] #mobile-menu-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  [data-menu-item] {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--menu-delay, 0ms);
  }

  #mobile-menu[data-open='true'] [data-menu-item] {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    #mobile-menu-backdrop,
    #mobile-menu-panel,
    [data-menu-item] {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  let cleanupNavbar: (() => void) | null = null;

  function setupNavbar() {
    cleanupNavbar?.();

    const siteHeader = document.getElementById('site-header');
    const hamburger = document.getElementById('hamburger');
    const mobileMenu = document.getElementById('mobile-menu');
    const closeBtn = document.getElementById('close-menu');
    const backdrop = document.getElementById('mobile-menu-backdrop');

    if (!hamburger || !mobileMenu || !closeBtn || !backdrop) return;

    const controller = new AbortController();
    const { signal } = controller;

    const updateHeaderOnScroll = () => {
      const isScrolled = window.scrollY > 20;
      siteHeader?.setAttribute('data-scrolled', isScrolled ? 'true' : 'false');
    };

    window.addEventListener('scroll', updateHeaderOnScroll, { passive: true, signal });
    updateHeaderOnScroll();

    function openMenu() {
      mobileMenu?.setAttribute('data-open', 'true');
      mobileMenu?.setAttribute('aria-hidden', 'false');
      mobileMenu?.removeAttribute('inert');
      hamburger?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      mobileMenu?.setAttribute('data-open', 'false');
      mobileMenu?.setAttribute('aria-hidden', 'true');
      mobileMenu?.setAttribute('inert', '');
      hamburger?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    const handleKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') closeMenu();
    };

    const handleResize = () => {
      if (window.innerWidth >= 768) closeMenu();
    };

    hamburger.addEventListener('click', openMenu, { signal });
    closeBtn.addEventListener('click', closeMenu, { signal });
    backdrop.addEventListener('click', closeMenu, { signal });
    document.addEventListener('keydown', handleKeydown, { signal });
    window.addEventListener('resize', handleResize, { signal });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu, { signal });
    });

    cleanupNavbar = () => {
      document.body.style.overflow = '';
      controller.abort();
      cleanupNavbar = null;
    };

    document.addEventListener('astro:before-preparation', cleanupNavbar, {
      once: true,
      signal,
    });
  }

  document.addEventListener('astro:page-load', setupNavbar);
  setupNavbar();
</script>
