---
import { localeDefinitions, type Locale } from "../../i18n/locales";
import { getPublishedCounterpart, getShellDestinationPath, type PageId } from "../../i18n/routes";
import type { ShellContent } from "../../i18n/content-types";
import { socialNetworks } from "../../data/social-networks";
import Icon from "../ui/Icon.astro";

interface Props {
  content: ShellContent;
  locale?: Locale;
  pageId?: PageId;
}

const { content, locale = "en-US", pageId } = Astro.props;
const counterpart = getPublishedCounterpart(pageId, locale);
const languageControlLabel = `${content.languageControl.label}: ${content.languageControl.destinationLabel}`;
const logoHref = getShellDestinationPath("home", locale);
const socialPlatformByIcon: Record<string, ShellContent["footer"]["socialLinks"][number]["platform"]> = {
  "tabler:brand-tiktok-filled": "TikTok",
  "tabler:brand-facebook-filled": "Facebook",
  "tabler:brand-instagram-filled": "Instagram",
  "tabler:brand-whatsapp-filled": "WhatsApp",
};
const socialLinks = socialNetworks.map((social) => {
  const platform = socialPlatformByIcon[social.name];
  const localized = content.footer.socialLinks.find((link) => link.platform === platform);
  if (!localized) throw new Error(`Missing shell social label for ${platform}`);
  return { ...social, accessibleLabel: localized.accessibleLabel };
});
const footerLinks = content.footer.links.map((link) => ({
  ...link,
  href: getShellDestinationPath(link.destination, locale),
}));
---

<footer class="bg-black border-t border-border py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center gap-5">
    <!-- Logo -->
    <a href={logoHref}>
      <img
        src="/images/logo.png"
        alt={content.brandLogoAlt}
        width="auto"
        height="40"
        class="h-10 w-auto object-contain"
      />
    </a>

    <!-- Social icons -->
    <ul aria-label={content.footer.socialLabel} class="flex items-center gap-3">
      {socialLinks.map(({ name, href, accessibleLabel }) => (
      <li class="flex justify-center items-center size-8 bg-white rounded-full hover:opacity-80">
        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={accessibleLabel} class="text-black">
          <Icon name={name} size="md" />  
        </a>
      </li>
      ))}
    </ul>

    <nav aria-label={content.footer.navigationLabel}>
      <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm font-medium text-text-secondary">
        {footerLinks.map(({ href, label }) => (
          <li><a class="transition-colors hover:text-gold" href={href}>{label}</a></li>
        ))}
        {counterpart && (
          <li>
            <a
              class="transition-colors hover:text-gold"
              href={counterpart.path}
              hreflang={localeDefinitions[counterpart.locale].htmlLang}
              aria-label={languageControlLabel}
            >
              {content.languageControl.destinationLabel}
            </a>
          </li>
        )}
      </ul>
    </nav>

    <p class="text-text-muted text-xs text-center">
      &copy; {new Date().getFullYear()} Duartes Auto Detailing. {content.footer.copyrightSuffix}
    </p>
  </div>
</footer>
