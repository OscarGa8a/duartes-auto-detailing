---
import { localeDefinitions, type Locale } from "../../i18n/locales";
import { getPublishedCounterpart, type PageId } from "../../i18n/routes";
import { socialNetworks } from "../../data/social-networks";
import Icon from "../ui/Icon.astro";

interface Props {
  locale?: Locale;
  pageId?: PageId;
}

const { locale = "en-US", pageId } = Astro.props;
const counterpart = getPublishedCounterpart(pageId, locale);
const counterpartLabel = counterpart && localeDefinitions[counterpart.locale].htmlLang === "es-US"
  ? "Español"
  : "English";
---

<footer class="bg-black border-t border-border py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center gap-5">
    <!-- Logo -->
    <a href="/">
      <img
        src="/images/logo.png"
        alt="Duartes Auto Detailing"
        width="auto"
        height="40"
        class="h-10 w-auto object-contain"
      />
    </a>

    <!-- Social icons -->
    <ul class="flex items-center gap-3">
      {socialNetworks.map(({ name, href, accessibleLabel }) => (
      <li class="flex justify-center items-center size-8 bg-white rounded-full hover:opacity-80">
        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={accessibleLabel} class="text-black">
          <Icon name={name} size="md" />  
        </a>
      </li>
      ))}
    </ul>

    <nav aria-label="Footer navigation">
      <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm font-medium text-text-secondary">
        <li><a class="transition-colors hover:text-gold" href="/services">Services</a></li>
        <li><a class="transition-colors hover:text-gold" href="/service-area/bay-area/">Bay Area Service Area</a></li>
        <li><a class="transition-colors hover:text-gold" href="/contact">Contact</a></li>
        {counterpart && (
          <li>
            <a
              class="transition-colors hover:text-gold"
              href={counterpart.path}
              hreflang={localeDefinitions[counterpart.locale].htmlLang}
            >
              {counterpartLabel}
            </a>
          </li>
        )}
      </ul>
    </nav>

    <p class="text-text-muted text-xs text-center">
      &copy; {new Date().getFullYear()} Duartes Auto Detailing. All rights reserved.
    </p>
  </div>
</footer>
