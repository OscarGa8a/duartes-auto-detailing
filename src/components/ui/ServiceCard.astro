---
import { CldImage } from 'astro-cloudinary';
import Button from './Button.astro';

interface Props {
  image: string;
  title: string;
  description: string;
  href?: string;
  buttonText?: string;
}

const { image, title, description, href, buttonText = "See more details" } = Astro.props;
---

<article class="group rounded-xl overflow-hidden flex flex-col h-full bg-surface-2 border border-border-soft shadow-lg transition-all duration-300 hover:border-gold/40 hover:shadow-[0_16px_36px_-12px_rgba(0,0,0,0.85)]">
  <div class="aspect-video overflow-hidden min-h-70">
    <a href={href} tabindex="-1" aria-hidden="true" class="block w-full h-full">
      <CldImage
        src={image}
        alt={title}
        width={600}
        height={300}
        sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 1024px) 50vw, 380px"
        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      />
    </a>
  </div>
  <div class="p-5 flex flex-col gap-3 flex-1">
    <h3 class="font-bold text-lg text-text-primary">{title}</h3>
    <p class="text-sm leading-relaxed flex-1 line-clamp-4 text-text-secondary">{description}</p>
    {href && (
      <Button href={href} variant="primary-bright" class="w-full text-center">
        {buttonText}
      </Button>
    )}
  </div>
</article>
