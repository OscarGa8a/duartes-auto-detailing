---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactComposition from '../components/sections/contact/ContactComposition.astro';
import { getPageJsonLd, getLocalBusinessJsonLd } from '../data/business';
import { englishContactContent } from '../i18n/contact-content';
import { getCanonicalPagePath } from '../i18n/routes';

const locale = "en-US";
const pageId = "contact";
const { metadata } = englishContactContent;
const pageTitle = metadata.title;
const pageDescription = metadata.description;
const schemaPath = getCanonicalPagePath(pageId, locale);
const site = Astro.site ?? new URL('https://duartesautodetailing.com');
const structuredData = [
  getLocalBusinessJsonLd(site),
  getPageJsonLd(site, 'ContactPage', schemaPath, metadata.schemaName, metadata.schemaDescription)
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  imageAlt={metadata.socialImageAlt}
  structuredData={structuredData}
  locale={locale}
  pageId={pageId}
>
  <ContactComposition content={englishContactContent} />
</BaseLayout>
