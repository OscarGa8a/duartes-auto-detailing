---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import StandardSection from '../components/sections/about/StandardSection.astro';
import PillarsSection from '../components/sections/about/PillarsSection.astro';
import BehindTheShine from '../components/sections/about/BehindTheShine.astro';
import CTABanner from '../components/ui/CTABanner.astro';
import { config, formattedNumber } from '../data/config';

const phoneMessage = encodeURIComponent(`Hello, I'd like to learn more about your services. Could you provide me with more information?`);
const phoneUrl = `sms:${config.phoneUSE164}?body=${phoneMessage}`;
---

<BaseLayout
  title="About Duartes Auto Detailing"
  description={`Meet Duartes Auto Detailing — ${config.yearsOfExperience}+ years of experience, with over ${formattedNumber(config.vehiclesDetailed)} vehicles detailed throughout the Bay Area, California.`}
>
  <PageHero
    title="Built Around Precision"
    backgroundImage={{ mobile: 'banner-about-mobile_dkxtxy', desktop: 'banner_about-web_uh2qcz' }}
    eyebrow="About Duartes"
    description={`For more than ${config.yearsOfExperience} years, Duartes Auto Detailing has delivered mobile detailing with the discipline, polish, and premium care Bay Area owners expect from a true luxury service experience.`}
  />
  <StandardSection />
  <PillarsSection />
  <BehindTheShine />
  <CTABanner
    image="cta_banner_utp6hb"
    eyebrow="Ready to experience the difference?"
    title="Schedule Your Appointment Today"
    description="Reserve your appointment and let us bring the Duartes standard directly to your driveway, office, or private garage."
    buttonText="Book Your Service"
    buttonHref={phoneUrl}
    buttonTarget="_blank"
    variant="premium"
  />
</BaseLayout>
