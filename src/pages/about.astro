---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutComposition from "../components/sections/about/AboutComposition.astro";
import { getPageJsonLd } from "../data/business";
import { englishAboutContent, resolveAboutTemplate } from "../i18n/about-content";

const { metadata } = englishAboutContent;
const pageDescription = resolveAboutTemplate(metadata.description);
const site = Astro.site ?? new URL("https://duartesautodetailing.com");
const structuredData = [
  getPageJsonLd(
    site,
    "AboutPage",
    "/about/",
    metadata.schemaName,
    resolveAboutTemplate(metadata.schemaDescription),
  ),
];
---

<BaseLayout
  title={metadata.title}
  description={pageDescription}
  imageAlt={metadata.socialImageAlt}
  structuredData={structuredData}
>
  <AboutComposition content={englishAboutContent} />
</BaseLayout>
