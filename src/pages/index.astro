---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeComposition from '../components/sections/home/HomeComposition.astro';
import { getCloudinaryImageUrl } from '../helpers/cloudinary';
import { getLocalBusinessJsonLd, getWebSiteJsonLd } from '../data/business';
import { englishHomeContent } from '../i18n/home-content';

const ogImage = getCloudinaryImageUrl('og-image_usi1ab');
const site = Astro.site ?? new URL('https://duartesautodetailing.com');
const structuredData = [getLocalBusinessJsonLd(site), getWebSiteJsonLd(site)];
---

<BaseLayout
  title="Bay Area Mobile Auto Detailing"
  description="Premium mobile auto detailing in the Bay Area, delivered to your home, office, or private garage. Book Duartes Auto Detailing today."
  ogImage={ogImage}
  imageAlt="Freshly detailed vehicle by Duartes Auto Detailing"
  structuredData={structuredData}
>
  <HomeComposition content={englishHomeContent} />
</BaseLayout>
