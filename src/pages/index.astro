---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/home/HeroSection.astro';
import WhyDuartes from '../components/sections/home/WhyDuartes.astro';
import FeaturedPackages from '../components/sections/home/FeaturedPackages.astro';
import Testimonials from '../components/sections/home/Testimonials.astro';
import Gallery from '../components/sections/home/Gallery.astro';
import DiscountBanner from '../components/sections/home/DiscountBanner.astro';
import { getCloudinaryImageUrl } from '../helpers/cloudinary';
import { getLocalBusinessJsonLd, getWebSiteJsonLd } from '../data/business';

const ogImage = getCloudinaryImageUrl('og-image_usi1ab');
const site = Astro.site ?? new URL('https://duartesautodetailing.com');
const structuredData = [getLocalBusinessJsonLd(site), getWebSiteJsonLd(site)];
---

<BaseLayout
  title="Bay Area Mobile Auto Detailing"
  description="Premium mobile auto detailing in the Bay Area, delivered to your home, office, or private garage. Book Duartes Auto Detailing today."
  ogImage={ogImage}
  imageAlt="Freshly detailed vehicle by Duartes Auto Detailing"
  structuredData={structuredData}
>
  <HeroSection />
  <WhyDuartes />
  <FeaturedPackages />
  <Testimonials />
  <Gallery />
  <DiscountBanner />
</BaseLayout>
