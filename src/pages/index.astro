---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeComposition from '../components/sections/home/HomeComposition.astro';
import { getCloudinaryImageUrl } from '../helpers/cloudinary';
import { getFaqPageJsonLd, getLocalBusinessJsonLd, getWebSiteJsonLd } from '../data/business';
import { englishHomeContent } from '../i18n/home-content';
import { homeFaqs } from '../data/home-faqs';

const { metadata } = englishHomeContent;
const ogImage = getCloudinaryImageUrl('og-image_usi1ab');
const site = Astro.site ?? new URL('https://duartesautodetailing.com');
const structuredData = [
  getLocalBusinessJsonLd(site),
  getWebSiteJsonLd(site),
  getFaqPageJsonLd(homeFaqs),
];
---

<BaseLayout
  title={metadata.title}
  description={metadata.description}
  ogImage={ogImage}
  imageAlt={metadata.socialImageAlt}
  structuredData={structuredData}
  locale="en-US"
  pageId="home"
>
  <HomeComposition content={englishHomeContent} locale="en-US" />
</BaseLayout>
