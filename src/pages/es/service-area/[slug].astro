---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import CTABanner from '../../../components/ui/CTABanner.astro';
import { services, type Service } from '../../../data/services';
import { priorityServiceAreaCities, type ServiceAreaCity } from '../../../data/service-areas';
import {
  getBreadcrumbListJsonLd,
  getSpanishCityServiceAreaJsonLd,
  getFaqPageJsonLd,
  getLocalBusinessJsonLd,
} from '../../../data/business';
import { spanishServiceDetails } from '../../../i18n/spanish-service-details';
import { spanishServiceAreaCities } from '../../../i18n/spanish-service-areas';
import { getPageHeroImageUrls } from '../../../helpers/cloudinary';

export function getStaticPaths() {
  return priorityServiceAreaCities.map((city) => ({
    params: { slug: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props as { city: ServiceAreaCity };
const localizedCity = spanishServiceAreaCities[city.slug] ?? {
  name: city.name,
  slug: city.slug,
  region: city.region,
  metaTitle: `Auto Detallado Móvil en ${city.name} | Duartes Auto Detailing`,
  metaDescription: `Servicio profesional de detallado automotriz móvil en ${city.name} por Duartes Auto Detailing. Opciones de detallado interior, exterior, integral, corrección y cerámico.`,
  heroDescription: `Servicio profesional de detallado automotriz móvil disponible en ${city.name} para citas en tu domicilio, oficina o garaje privado con acceso vehicular seguro.`,
  intro: `Duartes Auto Detailing ofrece citas de auto detallado móvil en ${city.name} como parte de su cobertura en ${city.region}. Atendemos directamente en tu ubicación cuando el vehículo se encuentra en un lugar de estacionamiento seguro y accesible.`,
  customerAngle: `Compartinos el estado de tu vehículo, tus objetivos de detallado y los detalles de acceso para confirmar disponibilidad y coordinar tu cita en ${city.name}.`,
  serviceGuidance: city.serviceGuidance,
  faqs: city.faqs,
};

const site = Astro.site ?? new URL('https://duartesautodetailing.com');
const highlightedServices = city.serviceHighlights
  .map((slug) => services.find((service) => service.slug === slug))
  .filter((service): service is Service => Boolean(service));
const relatedCities = city.relatedCitySlugs
  .map((slug) => priorityServiceAreaCities.find((item) => item.slug === slug))
  .filter((relatedCity): relatedCity is ServiceAreaCity => Boolean(relatedCity));

const structuredData = [
  getLocalBusinessJsonLd(site),
  getSpanishCityServiceAreaJsonLd(site, city, localizedCity.metaDescription),
  getFaqPageJsonLd(localizedCity.faqs),
  getBreadcrumbListJsonLd(site, [
    { name: 'Inicio', path: '/es/' },
    { name: 'Área de servicio', path: '/es/service-area/bay-area/' },
    { name: city.name, path: `/es/service-area/${city.slug}/` },
  ]),
];

const heroBackground = {
  mobile: 'banner-services-mobile_a1pwkn',
  desktop: 'banner-services-web_db80lf',
};
const heroPreload = getPageHeroImageUrls(heroBackground);
---

<BaseLayout
  title={localizedCity.metaTitle}
  description={localizedCity.metaDescription}
  imageAlt={`Servicio móvil de auto detallado Duartes Auto Detailing en ${city.name}`}
  structuredData={structuredData}
  locale="es-US"
  pageId="services"
  preloadImage={heroPreload}
>
  <PageHero
    title={`Auto Detallado Móvil en ${city.name}`}
    backgroundImage={heroBackground}
    eyebrow={`Área de cobertura en ${localizedCity.region}`}
    description={localizedCity.heroDescription}
  />

  <section class="bg-black py-10 lg:py-16 border-b border-border-soft relative overflow-hidden">
    <div class="motion-drift absolute -left-12 top-14 h-64 w-64 rounded-full bg-gold/10 blur-3xl"></div>
    <div class="motion-drift absolute right-0 bottom-0 h-64 w-64 rounded-full bg-wine/12 blur-3xl" style="--float-delay: 1.2s"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-start">
      <div data-reveal="up" class="flex flex-col gap-4">
        <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold">
          <span class="h-px w-10 bg-gold"></span>
          Servicio móvil a domicilio
        </span>
        <h2 class="text-h2 font-bold text-text-primary">Detallado que se adapta a tus horarios en {city.name}.</h2>
        <p class="text-text-secondary leading-relaxed">{localizedCity.intro}</p>
        <p class="text-text-secondary leading-relaxed">{localizedCity.customerAngle}</p>
      </div>

      <aside data-reveal="scale" class="rounded-4xl border border-gold/16 bg-surface/80 p-5 shadow-lg lg:p-7">
        <h2 class="text-h3 font-bold text-text-primary">Recomendaciones para tu cita</h2>
        <ul class="mt-4 grid gap-3 text-sm leading-relaxed text-text-secondary">
          <li class="flex items-start gap-3 rounded-2xl border border-white/8 bg-black/28 p-4 transition-colors duration-200 hover:border-gold/20">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-gold shadow-[0_0_8px_rgba(212,175,55,0.4)] shrink-0"></span>
            <span>El servicio móvil funciona de manera óptima en espacios de estacionamiento seguros y con suficiente lugar alrededor del vehículo.</span>
          </li>
          <li class="flex items-start gap-3 rounded-2xl border border-white/8 bg-black/28 p-4 transition-colors duration-200 hover:border-gold/20">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-gold shadow-[0_0_8px_rgba(212,175,55,0.4)] shrink-0"></span>
            <span>Indicá el estado del auto, tus objetivos de detallado y los detalles de acceso antes de agendar.</span>
          </li>
          <li class="flex items-start gap-3 rounded-2xl border border-white/8 bg-black/28 p-4 transition-colors duration-200 hover:border-gold/20">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-gold shadow-[0_0_8px_rgba(212,175,55,0.4)] shrink-0"></span>
            <span>La disponibilidad puede variar según el tipo de servicio, la distancia y los horarios programados.</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="bg-off-white py-10 lg:py-16 border-b border-divider-light/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      <div data-reveal="up" class="flex flex-col gap-3">
        <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold-deep">
          <span class="h-px w-10 bg-gold"></span>
          Servicios destacados
        </span>
        <h2 class="text-text-dark font-bold text-h2">Servicios recomendados para {city.name}</h2>
        <p data-city-service-guide class="text-text-dark/78 leading-relaxed">
          Elegí uno de estos paquetes principales o comunicate con Duartes Auto Detailing para ayudarte a elegir el servicio ideal según el estado de tu vehículo y tus expectativas. {localizedCity.serviceGuidance}
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {highlightedServices.map((service, index) => {
          const localized = spanishServiceDetails[service.id];
          const serviceName = localized?.name ?? service.name.trim();
          const serviceTagline = localized?.tagline ?? service.tagline;
          return (
            <a
              data-reveal="up"
              style={`--reveal-delay: ${index * 80}ms`}
              href={`/es/services/${service.slug}/`}
              class="group flex flex-col rounded-3xl border border-divider-light bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-gold/60 hover:shadow-lg active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2 touch-manipulation"
            >
              <h3 class="text-lg font-bold text-text-dark group-hover:text-gold-deep transition-colors">{serviceName}</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-dark/78">{serviceTagline}</p>
              <div class="mt-auto pt-4 flex items-center gap-1.5 text-xs font-semibold text-gold-deep border-t border-divider-light/60">
                <span>Ver detalles del servicio</span>
                <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="bg-black py-10 lg:py-16 border-b border-border-soft">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-8 lg:grid-cols-[1fr_0.85fr]">
      <div data-reveal="up" class="flex flex-col gap-5">
        <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold">
          <span class="h-px w-10 bg-gold"></span>
          Preguntas frecuentes
        </span>
        <h2 class="text-h2 font-bold text-text-primary">{city.name} - Preguntas frecuentes</h2>
        <div class="grid gap-4">
          {localizedCity.faqs.map((faq) => (
            <details class="faq-item group rounded-3xl border border-white/8 bg-surface p-5 transition-[border-color,background-color] duration-200 open:border-gold/30 open:bg-surface/90">
              <summary class="flex cursor-pointer items-center justify-between list-none text-base font-semibold text-text-primary group-hover:text-gold transition-colors active:scale-[0.99] select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/60 focus-visible:ring-offset-2 focus-visible:ring-offset-surface rounded-xl [&::-webkit-details-marker]:hidden">
                <span>{faq.question}</span>
                <span class="faq-icon ml-3 flex-shrink-0 text-gold/60 group-hover:text-gold transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="faq-content">
                <div class="faq-content-inner">
                  <p class="pt-3 text-sm leading-relaxed text-text-secondary">{faq.answer}</p>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>

      <aside data-reveal="up" style="--reveal-delay: 120ms" class="rounded-4xl border border-gold/16 bg-[linear-gradient(180deg,rgba(30,32,36,0.96),rgba(79,29,30,0.22))] p-6 lg:p-8 self-start">
        <h2 class="text-h3 font-bold text-text-primary">Otras zonas de cobertura</h2>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          Compará otras ciudades del Área de la Bahía o volvé al directorio principal de zonas de servicio.
        </p>
        <div class="mt-5 grid gap-3">
          <a class="group flex items-center justify-between rounded-2xl border border-white/8 bg-black/28 p-4 text-sm font-semibold text-gold transition-all duration-200 hover:border-gold/40 hover:bg-gold/[0.04] active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/60 focus-visible:ring-offset-2 focus-visible:ring-offset-surface touch-manipulation" href="/es/service-area/bay-area/">
            <span>Directorio del Área de la Bahía</span>
            <svg class="h-4 w-4 text-gold/40 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-gold shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          {relatedCities.map((relatedCity) => (
            <a class="group flex items-center justify-between rounded-2xl border border-white/8 bg-black/28 p-4 text-sm font-semibold text-text-primary transition-all duration-200 hover:border-gold/40 hover:text-gold hover:bg-gold/[0.04] active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/60 focus-visible:ring-offset-2 focus-visible:ring-offset-surface touch-manipulation" href={`/es/service-area/${relatedCity.slug}/`}>
              <span>{relatedCity.name} - Detallado móvil</span>
              <svg class="h-4 w-4 text-text-muted transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-gold shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <CTABanner
    image="cta_banner_utp6hb"
    eyebrow={`Detallado móvil en ${city.name}`}
    title="Agendá tu cita a domicilio"
    description={`Contanos qué vehículo tenés, qué servicio necesitás y los detalles del lugar de atención en ${city.name} para asesorarte con el paquete ideal.`}
    buttonText="Contactar a Duartes"
    buttonHref="/es/contact"
    variant="premium"
  />
</BaseLayout>

<style>
  .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 200ms cubic-bezier(0.4, 0, 1, 1);
  }

  .faq-content-inner {
    overflow: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 160ms ease-in,
      transform 200ms cubic-bezier(0.4, 0, 1, 1);
  }

  /* Expanding: 260ms natural deceleration with staggered opacity */
  details[open]:not(.is-closing) .faq-content {
    grid-template-rows: 1fr;
    transition: grid-template-rows 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  details[open]:not(.is-closing) .faq-content-inner {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 220ms ease-out 40ms,
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Chevron rotation */
  details[open]:not(.is-closing) .faq-icon {
    transform: rotate(180deg);
  }

  details.is-closing .faq-icon {
    transform: rotate(0deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-content,
    .faq-content-inner,
    .faq-icon {
      transition: none !important;
    }
  }
</style>

<script>
  function setupFaqAccordions() {
    const detailsList = document.querySelectorAll<HTMLDetailsElement>('details.faq-item');

    detailsList.forEach((detail) => {
      const summary = detail.querySelector('summary');
      const content = detail.querySelector('.faq-content');
      if (!summary || !content) return;

      summary.addEventListener('click', (event) => {
        if (detail.classList.contains('is-closing')) {
          event.preventDefault();
          return;
        }

        if (detail.open) {
          event.preventDefault();
          detail.classList.add('is-closing');

          setTimeout(() => {
            detail.removeAttribute('open');
            detail.classList.remove('is-closing');
          }, 210);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupFaqAccordions);
  setupFaqAccordions();
</script>
