---
import '../styles/global.css';
---

<!doctype html>
<html lang="es-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Página no encontrada / Page not found | Duartes Auto Detailing</title>
    <meta
      name="description"
      content="La página solicitada no está disponible. The requested page is unavailable. Return to Duartes Auto Detailing home page."
    />
  </head>
  <body>
    <div class="error-page">
      <div class="ambient-glow" aria-hidden="true"></div>
      <div class="grain" aria-hidden="true"></div>

      <main class="error-main">
        <aside class="brand-panel">
          <picture class="brand-picture">
            <source srcset="/images/logo.webp" type="image/webp" />
            <img src="/images/logo.png" alt="Duartes Auto Detailing" width="184" height="184" loading="eager" decoding="async" />
          </picture>
          <span class="brand-rule" aria-hidden="true"></span>
        </aside>

        <div class="content-panel">
          <div class="status-badge" role="status" aria-label="Error 404">
            <span class="status-dot" aria-hidden="true"></span>
            <span>Error 404 · Ruta no encontrada / Page not found</span>
          </div>

          <div class="bilingual-grid">
            <article class="lang-block lang-es">
              <div class="lang-tag" aria-hidden="true">
                <span class="lang-tag-code">ES</span>
                <span class="lang-tag-label">Español</span>
              </div>
              <h1 class="heading">Parece que este camino necesita un detalle.</h1>
              <p class="explanation">
                La página que buscás no está disponible o cambió de lugar. Volvé al inicio para explorar nuestros servicios y agendar tu cita.
              </p>
            </article>

            <div class="bilingual-rule" aria-hidden="true"></div>

            <article class="lang-block lang-en">
              <div class="lang-tag" aria-hidden="true">
                <span class="lang-tag-code">EN</span>
                <span class="lang-tag-label">English</span>
              </div>
              <h2 class="heading" lang="en">Looks like this route could use a detail.</h2>
              <p class="explanation" lang="en">
                The page you requested is unavailable or has moved. Return home to explore our detailing packages and schedule your service.
              </p>
            </article>
          </div>

          <div class="action-wrapper">
            <a class="home-action" href="/">
              <svg class="action-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
              <span class="action-labels">
                <span>Volver al inicio</span>
                <span class="action-sep" aria-hidden="true">/</span>
                <span>Back home</span>
              </span>
            </a>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>

<style>
  :global(body) {
    min-width: 320px;
    background: #0b0c0e;
    color: #f7f4ee;
  }

  .error-page {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100dvh;
    overflow: hidden;
    background: #0b0c0e;
  }

  .error-main {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(6rem, auto) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2.5rem, 5vw, 5rem);
    width: min(100% - 3rem, 74rem);
    margin: auto;
    padding: 3.5rem 0;
  }

  .brand-panel {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .brand-picture {
    display: block;
  }

  .brand-picture img {
    width: clamp(5.5rem, 9vw, 9.5rem);
    height: auto;
    filter: drop-shadow(0 1.25rem 2rem rgb(0 0 0 / 0.6));
  }

  .brand-rule {
    width: clamp(3.5rem, 6vw, 5.5rem);
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(90deg, #d4af37, rgba(212, 175, 55, 0.15));
  }

  .content-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 2rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid rgba(212, 175, 55, 0.28);
    border-radius: 9999px;
    background: rgba(212, 175, 55, 0.06);
    color: #e7c86a;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background: #d4af37;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .bilingual-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    width: 100%;
    margin-bottom: 2.5rem;
  }

  .lang-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .lang-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lang-tag-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
    color: #d4af37;
  }

  .lang-tag-label {
    font-weight: 500;
    color: #cfc8bd;
  }

  .heading {
    margin: 0.85rem 0 0;
    color: #f7f4ee;
    font-size: clamp(1.6rem, 2.8vw, 2.35rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .explanation {
    margin: 0.85rem 0 0;
    color: #b8b1a4;
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 32ch;
  }

  .bilingual-rule {
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(212, 175, 55, 0.3) 20%, rgba(212, 175, 55, 0.3) 80%, transparent);
  }

  .action-wrapper {
    display: flex;
  }

  .home-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.85rem 1.85rem;
    border: 1px solid #d4af37;
    border-radius: 0.65rem;
    background: #d4af37;
    color: #0c0d0f;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    touch-action: manipulation;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    transition:
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .home-action .action-icon {
    flex-shrink: 0;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .home-action .action-labels {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .home-action .action-sep {
    opacity: 0.45;
  }

  .home-action:hover {
    background: #f4e8bc;
    border-color: #f4e8bc;
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6);
  }

  .home-action:hover .action-icon {
    transform: scale(1.08);
  }

  .home-action:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }

  .home-action:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 4px;
  }

  .ambient-glow,
  .grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ambient-glow {
    z-index: 0;
    background:
      radial-gradient(ellipse 60% 45% at 20% 25%, rgba(212, 175, 55, 0.08), transparent 70%),
      radial-gradient(ellipse 50% 40% at 85% 75%, rgba(212, 175, 55, 0.05), transparent 70%);
  }

  .grain {
    z-index: 0;
    opacity: 0.16;
    background-image: radial-gradient(rgb(247 244 238 / 0.22) 0.5px, transparent 0.5px);
    background-size: 5px 5px;
    mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
  }

  @media (max-width: 860px) {
    .error-main {
      grid-template-columns: 1fr;
      gap: 2rem;
      width: min(100% - 2.5rem, 36rem);
      padding: 2.5rem 0;
    }

    .brand-panel {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .brand-panel .brand-rule {
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, rgba(212, 175, 55, 0.5), transparent);
    }

    .brand-picture img {
      width: 5.5rem;
    }

    .status-badge {
      margin-bottom: 1.5rem;
    }

    .bilingual-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      margin-bottom: 2rem;
    }

    .bilingual-rule {
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.3) 15%, rgba(212, 175, 55, 0.3) 85%, transparent);
    }

    .explanation {
      max-width: none;
    }

    .action-wrapper {
      width: 100%;
    }

    .home-action {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-action,
    .home-action .action-icon {
      transition: none;
    }
  }
</style>
