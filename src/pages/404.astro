---
import '../styles/global.css';
---

<!doctype html>
<html lang="es-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Página no encontrada / Page not found | Duartes Auto Detailing</title>
    <meta
      name="description"
      content="La página solicitada no está disponible. The requested page is unavailable. Return to Duartes Auto Detailing home page."
    />
  </head>
  <body>
    <div class="error-page">
      <div class="reflection reflection-one" aria-hidden="true"></div>
      <div class="reflection reflection-two" aria-hidden="true"></div>
      <div class="grain" aria-hidden="true"></div>

      <main class="error-main">
        <div class="brand-mark">
          <picture class="contents">
            <source srcset="/images/logo.webp" type="image/webp" />
            <img src="/images/logo.png" alt="Duartes Auto Detailing" width="184" height="184" loading="eager" decoding="async" />
          </picture>
          <span class="brand-divider" aria-hidden="true"></span>
        </div>

        <div class="content">
          <div class="status-badge" role="status" aria-label="Error 404">
            <span class="status-dot" aria-hidden="true"></span>
            <span>Error 404 · Ruta no encontrada</span>
          </div>

          <h1>Parece que este camino necesita un detalle.</h1>
          <p class="english-support" lang="en">Looks like this route could use a detail.</p>
          <p class="explanation">
            La página que buscás no está disponible o cambió de lugar. Volvé al inicio para continuar explorando nuestros servicios y agendar tu cita.
          </p>
          <p class="explanation" lang="en">
            The page you requested is unavailable or has moved. Return home to explore our detailing packages and schedule your service.
          </p>

          <div class="action-wrapper">
            <a class="home-action" href="/">
              <svg class="action-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
              <span>Volver al inicio / Back home</span>
            </a>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>

<style>
  :global(body) {
    min-width: 320px;
    background: #0f1012;
    color: #f7f4ee;
  }

  .error-page {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100dvh;
    overflow: hidden;
    background: #0f1012;
  }

  .error-main {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(7rem, 0.7fr) minmax(0, 1.3fr);
    align-items: center;
    gap: clamp(2.5rem, 8vw, 9rem);
    width: min(100% - 3rem, 72rem);
    margin: auto;
    padding: 3rem 0;
  }

  .brand-mark {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .brand-mark img {
    width: clamp(5.5rem, 11vw, 11.5rem);
    height: auto;
    filter: drop-shadow(0 1.5rem 2.5rem rgb(0 0 0 / 0.5));
  }

  .brand-divider {
    width: clamp(4rem, 8vw, 7rem);
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(90deg, #d4af37, rgba(212, 175, 55, 0.2));
  }

  .content {
    max-width: 42rem;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid rgba(212, 175, 55, 0.28);
    border-radius: 9999px;
    background: rgba(212, 175, 55, 0.08);
    color: #e7c86a;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .status-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background: #d4af37;
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.7);
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    color: #f7f4ee;
    font-size: clamp(2.4rem, 5.4vw, 5.2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .english-support {
    margin: 1.25rem 0 0;
    color: #f4e8bc;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-weight: 500;
    line-height: 1.5;
  }

  .explanation {
    max-width: 38rem;
    margin: 0.75rem 0 0;
    color: #d6d0c4;
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .action-wrapper {
    margin-top: 2.25rem;
  }

  .home-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 3.25rem;
    padding: 0.85rem 1.75rem;
    border: 1px solid #d4af37;
    border-radius: 0.65rem;
    background: #d4af37;
    color: #141517;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    touch-action: manipulation;
    box-shadow: 0 4px 14px -3px rgba(212, 175, 55, 0.35);
    transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .home-action .action-icon {
    flex-shrink: 0;
    transition: transform 180ms ease;
  }

  .home-action:hover {
    background: #f4e8bc;
    border-color: #f4e8bc;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -4px rgba(212, 175, 55, 0.45);
  }

  .home-action:hover .action-icon {
    transform: scale(1.1);
  }

  .home-action:active {
    transform: scale(0.98);
  }

  .home-action:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 4px;
  }

  .reflection,
  .grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .reflection-one {
    z-index: -2;
    background:
      linear-gradient(112deg, transparent 24%, rgb(231 200 106 / 0.1) 42%, transparent 57%),
      radial-gradient(ellipse 70% 55% at 110% 8%, rgb(212 175 55 / 0.15), transparent 68%);
    transform: translate3d(0, 0, 0);
  }

  .reflection-two {
    z-index: -1;
    background: linear-gradient(142deg, transparent 46%, rgb(247 244 238 / 0.06) 50%, transparent 54%);
    opacity: 0.7;
  }

  .grain {
    z-index: 0;
    opacity: 0.18;
    background-image: radial-gradient(rgb(247 244 238 / 0.24) 0.55px, transparent 0.55px);
    background-size: 5px 5px;
    mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .reflection-one {
      animation: reflective-drift 12s ease-in-out infinite alternate;
      will-change: transform, opacity;
    }

    .reflection-two {
      animation: reflective-pulse 8s ease-in-out infinite alternate;
      will-change: opacity;
    }

    .status-dot {
      animation: dot-pulse 3s ease-in-out infinite;
    }
  }

  @keyframes dot-pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 0 0 8px rgba(212, 175, 55, 0.7);
    }
    50% {
      opacity: 0.65;
      transform: scale(0.9);
      box-shadow: 0 0 4px rgba(212, 175, 55, 0.3);
    }
  }

  @keyframes reflective-drift {
    from {
      opacity: 0.62;
      transform: translate3d(-2%, -1%, 0) scale(1);
    }

    to {
      opacity: 1;
      transform: translate3d(3%, 2%, 0) scale(1.04);
    }
  }

  @keyframes reflective-pulse {
    from { opacity: 0.28; }
    to { opacity: 0.82; }
  }

  @media (max-width: 700px) {
    .error-main {
      grid-template-columns: 1fr;
      gap: 2rem;
      width: min(100% - 2.5rem, 34rem);
      padding: 2.5rem 0;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .brand-mark .brand-divider {
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, rgba(212, 175, 55, 0.6), transparent);
    }

    .brand-mark img {
      width: 5.5rem;
    }

    h1 {
      max-width: 14ch;
    }

    .home-action {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reflection-one,
    .reflection-two,
    .status-dot {
      animation: none;
    }
  }
</style>
