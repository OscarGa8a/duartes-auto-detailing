---
import '../styles/global.css';
---

<!doctype html>
<html lang="es-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Page not found | Duartes Auto Detailing</title>
    <meta
      name="description"
      content="The requested page is not available. Return to the Duartes Auto Detailing home page."
    />
  </head>
  <body>
    <div class="error-page">
      <div class="reflection reflection-one" aria-hidden="true"></div>
      <div class="reflection reflection-two" aria-hidden="true"></div>
      <div class="grain" aria-hidden="true"></div>

      <main class="error-main">
        <div class="brand-mark">
          <img src="/images/logo.png" alt="Duartes Auto Detailing" width="184" height="184" />
          <span aria-hidden="true"></span>
        </div>

        <div class="content">
          <p class="status">404</p>
          <h1>Parece que este camino necesita un detalle.</h1>
          <p class="english-support" lang="en">Looks like this route could use a detail.</p>
          <p class="explanation">
            La página que buscás no está disponible o cambió de lugar. Volvé al inicio para continuar explorando.
          </p>
          <p class="explanation" lang="en">
            The page you requested is unavailable or has moved. Return home to keep exploring.
          </p>
          <a class="home-action" href="/">Volver al inicio / Back home</a>
        </div>
      </main>
    </div>
  </body>
</html>

<style>
  :global(body) {
    min-width: 320px;
  }

  .error-page {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100dvh;
    overflow: hidden;
    background: #0f1012;
  }

  .error-main {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(7rem, 0.7fr) minmax(0, 1.3fr);
    align-items: center;
    gap: clamp(2.5rem, 8vw, 9rem);
    width: min(100% - 3rem, 72rem);
    margin: auto;
    padding: 3rem 0;
  }

  .brand-mark {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .brand-mark img {
    width: clamp(5rem, 11vw, 11.5rem);
    height: auto;
    filter: drop-shadow(0 1.5rem 2.5rem rgb(0 0 0 / 0.45));
  }

  .brand-mark span {
    width: clamp(4rem, 8vw, 7rem);
    height: 1px;
    background: #d4af37;
  }

  .content {
    max-width: 42rem;
  }

  .status {
    margin: 0 0 1.25rem;
    color: #e7c86a;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    color: #f7f4ee;
    font-size: clamp(2.65rem, 5.8vw, 5.6rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.04;
  }

  .english-support {
    margin: 1.5rem 0 0;
    color: #f4e8bc;
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 500;
    line-height: 1.5;
  }

  .explanation {
    max-width: 38rem;
    margin: 0.75rem 0 0;
    color: #d6d0c4;
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .home-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 13.5rem;
    min-height: 3rem;
    margin-top: 2rem;
    padding: 0.7rem 1.25rem;
    border: 1px solid #d4af37;
    border-radius: 0.5rem;
    background: #d4af37;
    color: #18191b;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    transition: transform 180ms ease, background-color 180ms ease, color 180ms ease;
  }

  .home-action:hover {
    background: #f4e8bc;
  }

  .home-action:active {
    transform: translateY(1px);
  }

  .home-action:focus-visible {
    outline: 3px solid #f7f4ee;
    outline-offset: 4px;
  }

  .reflection,
  .grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .reflection-one {
    z-index: -2;
    background:
      linear-gradient(112deg, transparent 24%, rgb(231 200 106 / 0.1) 42%, transparent 57%),
      radial-gradient(ellipse 70% 55% at 110% 8%, rgb(212 175 55 / 0.15), transparent 68%);
    transform: translate3d(0, 0, 0);
  }

  .reflection-two {
    z-index: -1;
    background: linear-gradient(142deg, transparent 46%, rgb(247 244 238 / 0.06) 50%, transparent 54%);
    opacity: 0.7;
  }

  .grain {
    z-index: 0;
    opacity: 0.18;
    background-image: radial-gradient(rgb(247 244 238 / 0.24) 0.55px, transparent 0.55px);
    background-size: 5px 5px;
    mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .reflection-one {
      animation: reflective-drift 12s ease-in-out infinite alternate;
      will-change: transform, opacity;
    }

    .reflection-two {
      animation: reflective-pulse 8s ease-in-out infinite alternate;
      will-change: opacity;
    }
  }

  @keyframes reflective-drift {
    from {
      opacity: 0.62;
      transform: translate3d(-2%, -1%, 0) scale(1);
    }

    to {
      opacity: 1;
      transform: translate3d(3%, 2%, 0) scale(1.04);
    }
  }

  @keyframes reflective-pulse {
    from { opacity: 0.28; }
    to { opacity: 0.82; }
  }

  @media (max-width: 700px) {
    .error-main {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      width: min(100% - 2.5rem, 34rem);
      padding: 2.5rem 0;
    }

    .brand-mark {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 1rem;
    }

    .brand-mark span {
      width: 100%;
    }

    h1 {
      max-width: 12ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reflection-one,
    .reflection-two {
      animation: none;
    }
  }
</style>
