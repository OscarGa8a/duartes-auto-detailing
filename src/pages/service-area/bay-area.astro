---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import { services } from '../../data/services';
import {
  priorityServiceAreaCities,
  serviceAreaHub,
} from '../../data/service-areas';
import {
  getBreadcrumbListJsonLd,
  getLocalBusinessJsonLd,
  getServiceAreaHubJsonLd,
} from '../../data/business';
import { getPageHeroImageUrls } from '../../helpers/cloudinary';

const site = Astro.site ?? new URL('https://duartesautodetailing.com');
const structuredData = [
  getLocalBusinessJsonLd(site),
  getServiceAreaHubJsonLd(site),
  getBreadcrumbListJsonLd(site, [
    { name: 'Home', path: '/' },
    { name: 'Service Area', path: '/service-area/bay-area/' },
  ]),
];

const featuredServices = services.filter((service) =>
  ['interior-detailing', 'exterior-detailing', 'full-detailing', 'ceramic-coating'].includes(service.slug)
);

const heroBackground = {
  mobile: 'banner-services-mobile_a1pwkn',
  desktop: 'banner-services-web_db80lf',
};
const heroPreload = getPageHeroImageUrls(heroBackground);
---

<BaseLayout
  title={serviceAreaHub.metaTitle}
  description={serviceAreaHub.metaDescription}
  imageAlt="Duartes Auto Detailing Bay Area mobile service"
  structuredData={structuredData}
  locale="en-US"
  pageId="services"
  preloadImage={heroPreload}
>
  <PageHero
    title="Bay Area Mobile Auto Detailing Service Area"
    backgroundImage={heroBackground}
    eyebrow="Service area"
    description={serviceAreaHub.heroDescription}
  />

  <section class="bg-black py-10 lg:py-16 border-b border-border-soft relative overflow-hidden">
    <div class="motion-drift absolute -left-12 top-14 h-64 w-64 rounded-full bg-gold/10 blur-3xl"></div>
    <div class="motion-drift absolute right-0 bottom-0 h-64 w-64 rounded-full bg-wine/12 blur-3xl" style="--float-delay: 1.2s"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div data-reveal="up" class="flex flex-col gap-4">
        <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold">
          <span class="h-px w-10 bg-gold"></span>
          Mobile detailing near you
        </span>
        <h2 class="text-h2 font-bold text-text-primary">Professional detailing across the Bay Area.</h2>
        <p class="text-text-secondary leading-relaxed">
          Duartes Auto Detailing brings premium vehicle care to customers across the Bay Area. The service is designed for drivers who want interior cleaning, exterior detailing, full details, paint correction, or ceramic coating without losing time to a traditional shop visit.
        </p>
        <p class="text-text-secondary leading-relaxed">
          Appointments can be scheduled at homes, offices, and private garages when there is safe access to the vehicle. Service availability can vary by distance, appointment timing, vehicle condition, and the package selected.
        </p>
      </div>

      <div data-reveal="scale" class="rounded-4xl border border-gold/16 bg-surface/80 p-5 shadow-lg lg:p-7">
        <h3 class="text-h3 font-bold text-text-primary">Service city pages</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary">
          Browse the configured city guides below. Each page explains how mobile service works for that local area and links to relevant detailing services.
        </p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          {priorityServiceAreaCities.map((city) => (
            <a
              href={`/service-area/${city.slug}/`}
              class="group flex items-center justify-between rounded-2xl border border-white/8 bg-black/32 p-4 transition-all duration-200 hover:border-gold/40 hover:bg-gold/[0.04] hover:-translate-y-0.5 active:scale-[0.98]"
            >
              <div>
                <span class="text-sm font-semibold text-gold group-hover:text-gold-light transition-colors">{city.name}</span>
                <span class="mt-0.5 block text-xs tracking-wide text-text-muted">{city.region} · Mobile detailing</span>
              </div>
              <svg class="h-4 w-4 text-gold/40 transition-transform duration-200 group-hover:translate-x-1 group-hover:text-gold shrink-0 ml-2" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-off-white py-10 lg:py-16 border-b border-divider-light/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      <div data-reveal="up" class="flex flex-col gap-3">
        <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold-deep">
          <span class="h-px w-10 bg-gold"></span>
          Service options
        </span>
        <h2 class="text-text-dark font-bold text-h2">Detailing packages available in the service area.</h2>
        <p class="text-text-dark/72 leading-relaxed">
          Choose the level of care that matches your vehicle: a targeted interior refresh, a glossy exterior detail, a complete inside-and-out service, or paint protection work for long-term maintenance.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {featuredServices.map((service, index) => (
          <a
            data-reveal="up"
            style={`--reveal-delay: ${index * 80}ms`}
            href={`/services/${service.slug}/`}
            class="group flex flex-col rounded-3xl border border-divider-light bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-gold/60 hover:shadow-lg active:scale-[0.98]"
          >
            <h3 class="text-lg font-bold text-text-dark group-hover:text-gold-deep transition-colors">{service.name.trim()}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-dark/68">{service.tagline}</p>
            <div class="mt-auto pt-4 flex items-center gap-1.5 text-xs font-semibold text-gold-deep border-t border-divider-light/60">
              <span>Explore service details</span>
              <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-black py-10 lg:py-16 border-b border-border-soft">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-8 lg:grid-cols-[1fr_1fr]">
      <div data-reveal="up" class="rounded-4xl border border-white/8 bg-surface p-6 lg:p-8 flex flex-col justify-between">
        <div>
          <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold">
            <span class="h-px w-10 bg-gold"></span>
            Extended coverage
          </span>
          <h2 class="mt-2 text-h2 font-bold text-text-primary">Need another nearby city?</h2>
          <p class="mt-3 text-text-secondary leading-relaxed">
            The public city pages now cover the confirmed service-area list. If your appointment is near one of these communities, <a href="/contact/" class="text-gold font-medium hover:underline inline-flex items-center gap-0.5">contact Duartes Auto Detailing</a> with the exact location so the team can confirm availability before booking.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/6">
          <a
            href="/contact/"
            class="inline-flex items-center gap-2 text-sm font-semibold text-gold hover:text-gold-light transition-colors active:scale-[0.98]"
          >
            <span>Inquire about custom location</span>
            <svg class="h-4 w-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <div data-reveal="up" style="--reveal-delay: 120ms" class="rounded-4xl border border-gold/16 bg-[linear-gradient(180deg,rgba(30,32,36,0.96),rgba(79,29,30,0.22))] p-6 lg:p-8">
        <span class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-gold">
          <span class="h-px w-10 bg-gold"></span>
          Appointment process
        </span>
        <h2 class="mt-2 text-h2 font-bold text-text-primary">How mobile appointments work</h2>
        <ol class="mt-5 grid gap-3 text-text-secondary list-none p-0 m-0">
          <li class="flex items-start gap-3.5 rounded-2xl border border-white/6 bg-black/28 p-3.5">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gold/15 text-xs font-bold text-gold mt-0.5">1</span>
            <div class="text-sm leading-relaxed">
              <strong class="text-text-primary block font-semibold mb-0.5">Choose your service.</strong>
              <span>Start with the package that fits your vehicle condition and finish goals.</span>
            </div>
          </li>
          <li class="flex items-start gap-3.5 rounded-2xl border border-white/6 bg-black/28 p-3.5">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gold/15 text-xs font-bold text-gold mt-0.5">2</span>
            <div class="text-sm leading-relaxed">
              <strong class="text-text-primary block font-semibold mb-0.5">Share your location details.</strong>
              <span>Confirm parking access, available space, and any service notes.</span>
            </div>
          </li>
          <li class="flex items-start gap-3.5 rounded-2xl border border-white/6 bg-black/28 p-3.5">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gold/15 text-xs font-bold text-gold mt-0.5">3</span>
            <div class="text-sm leading-relaxed">
              <strong class="text-text-primary block font-semibold mb-0.5">Get the vehicle detailed on-site.</strong>
              <span>The team brings the service to your suitable home, office, or private garage location.</span>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <CTABanner
    image="cta_banner_utp6hb"
    eyebrow="Ready to book?"
    title="Schedule Mobile Detailing In Your Area"
    description="Tell us your city, vehicle, and service goals so we can help confirm availability and recommend the right detail."
    buttonText="Contact Duartes"
    buttonHref="/contact"
    variant="premium"
  />
</BaseLayout>
