---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetailHero from '../../components/sections/services/ServiceDetailHero.astro';
import ServiceVideoEmbed from '../../components/sections/services/ServiceVideoEmbed.astro';
import RelatedServices from '../../components/sections/services/RelatedServices.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import { services, getRelatedServices } from '../../data/services';
import { config } from '../../data/config';
import { getLocalBusinessJsonLd, getServiceJsonLd } from '../../data/business';
import { getCloudinaryImageUrl } from '../../helpers/cloudinary';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const related = getRelatedServices(service.relatedSlugs);

const pageTitle = `${service.name.trim()} in the Bay Area`;
const pageDescription = `${service.tagline} Mobile service available across the Bay Area.`;
const candidateOgImage = getCloudinaryImageUrl(service.ogImage ?? service.images[0] ?? '', 'f_auto,q_auto,w_1200,h_630,c_fill');
const ogImage = candidateOgImage.startsWith('http') || candidateOgImage.startsWith('/') ? candidateOgImage : undefined;
const site = Astro.site ?? new URL('https://duartesautodetailing.com');
const structuredData = [getLocalBusinessJsonLd(site), getServiceJsonLd(site, service)];

const phoneMessage = encodeURIComponent(`Hello, I'd like to book the service: ${service.name}`);
const phoneUrl = `sms:${config.phoneUSE164}?body=${phoneMessage}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  imageAlt={`${service.name.trim()} result by Duartes Auto Detailing`}
  structuredData={structuredData}
>
  <ServiceDetailHero service={service} />

  {service.video && (
    <ServiceVideoEmbed video={service.video} serviceSlug={service.slug} />
  )}

  {related.length > 0 && (
    <RelatedServices services={related} />
  )}

  <CTABanner
    image="cta_banner_utp6hb"
    eyebrow="Ready to book this service?"
    title="Schedule Your Appointment Today"
    description={`Reserve ${service.name.toLowerCase()} and let us bring premium mobile detailing directly to your home, office, or private garage.`}
    buttonText="Book Your Service"
    buttonHref={phoneUrl}
    buttonTarget="_blank"
    variant="premium"
  />
</BaseLayout>
