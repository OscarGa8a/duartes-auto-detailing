---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicesComposition from '../../components/sections/services/ServicesComposition.astro';
import { getLocalBusinessJsonLd, getServicesItemListJsonLd } from '../../data/business';
import { services } from '../../data/services';
import { getCloudinaryImageUrl } from '../../helpers/cloudinary';
import { englishServicesContent } from '../../i18n/services-content';

const locale = "en-US";
const pageId = "services";
const site = Astro.site ?? new URL('https://duartesautodetailing.com');
const structuredData = [getLocalBusinessJsonLd(site), getServicesItemListJsonLd(site)];
const candidateOgImage = getCloudinaryImageUrl(services[0]?.images[0] ?? '', 'f_auto,q_auto,w_1200,h_630,c_fill');
const ogImage = candidateOgImage.startsWith('http') || candidateOgImage.startsWith('/') ? candidateOgImage : undefined;
---

<BaseLayout
  title={englishServicesContent.metadata.title}
  description={englishServicesContent.metadata.description}
  ogImage={ogImage}
  imageAlt={englishServicesContent.metadata.socialImageAlt}
  structuredData={structuredData}
  locale={locale}
  pageId={pageId}
>
  <ServicesComposition content={englishServicesContent} locale={locale} />
</BaseLayout>
