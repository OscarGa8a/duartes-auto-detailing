---
import SEOHead from '../components/seo/SEOHead.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { localeDefinitions, type Locale } from '../i18n/locales';
import type { PageId } from '../i18n/routes';
import { englishShellContent, spanishShellContent } from '../i18n/shell-content';
import '../styles/global.css';

type JsonLd = Record<string, unknown> | Record<string, unknown>[];

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  imageAlt?: string;
  structuredData?: JsonLd;
  locale?: Locale;
  pageId?: PageId;
  preloadImage?:
    | string
    | {
        mobile?: string;
        tablet?: string;
        desktop?: string;
      };
}

const {
  title,
  description,
  ogImage,
  imageAlt,
  structuredData,
  locale = 'en-US',
  pageId,
  preloadImage,
} = Astro.props;
const localeDefinition = localeDefinitions[locale];
const shellContent = locale === 'es-US' ? spanishShellContent : englishShellContent;
---

<!doctype html>
<html lang={localeDefinition.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- Google Tag Manager -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function initGTM() {
        if (window._gtmInit) return;
        window._gtmInit = true;
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var j = document.createElement('script');
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-T3TZG9DL';
        var f = document.getElementsByTagName('script')[0];
        f.parentNode.insertBefore(j, f);
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(function() { setTimeout(initGTM, 3500); }, { timeout: 5000 });
      } else {
        setTimeout(initGTM, 4000);
      }
      ['scroll', 'touchstart', 'mousemove', 'keydown', 'click'].forEach(function(e) {
        window.addEventListener(e, initGTM, { once: true, passive: true });
      });
    </script>
    <!-- End Google Tag Manager -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <SEOHead title={title} description={description} ogImage={ogImage} imageAlt={imageAlt} locale={locale} pageId={pageId} />
    {preloadImage && typeof preloadImage === 'string' && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    {preloadImage && typeof preloadImage === 'object' && (
      <>
        {preloadImage.desktop && (
          <link rel="preload" as="image" href={preloadImage.desktop} media="(min-width: 1024px)" fetchpriority="high" />
        )}
        {preloadImage.tablet && (
          <link rel="preload" as="image" href={preloadImage.tablet} media="(min-width: 640px) and (max-width: 1023px)" fetchpriority="high" />
        )}
        {preloadImage.mobile && (
          <link rel="preload" as="image" href={preloadImage.mobile} media="(max-width: 639px)" fetchpriority="high" />
        )}
      </>
    )}
    <slot name="head" />
    {structuredData && <StructuredData data={structuredData} />}
    <style>
      .gslide-media {
        height: auto !important;
      }
    </style>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        title="Google Tag Manager"
        src="https://www.googletagmanager.com/ns.html?id=GTM-T3TZG9DL"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <ClientRouter />
    <Navbar content={shellContent} locale={locale} pageId={pageId} />
    <main>
      <slot />
    </main>
    <Footer content={shellContent} locale={locale} pageId={pageId} />
    <script>
      let revealObserver: IntersectionObserver | null = null;
      let countupObserver: IntersectionObserver | null = null;
      let motionAbortController: AbortController | null = null;

      function initScrollReveal() {
        document.documentElement.classList.add('js');

        if (revealObserver) {
          revealObserver.disconnect();
          revealObserver = null;
        }

        const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (!elements.length) return;

        const checkPendingElements = () => {
          const pending = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
          if (!pending.length) return;
          const windowHeight = window.innerHeight;
          pending.forEach((el) => {
            const rect = el.getBoundingClientRect();
            if (rect.top <= windowHeight + 60) {
              el.classList.add('is-visible');
              revealObserver?.unobserve(el);
            }
          });
        };

        revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting || entry.boundingClientRect.top <= window.innerHeight + 60) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0, rootMargin: '0px 0px 60px 0px' }
        );

        elements.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top <= window.innerHeight + 60) {
            el.classList.add('is-visible');
          } else {
            el.classList.remove('is-visible');
            revealObserver!.observe(el);
          }
        });

        if (motionAbortController) {
          motionAbortController.abort();
        }
        motionAbortController = new AbortController();
        const { signal } = motionAbortController;

        window.addEventListener('scroll', checkPendingElements, { passive: true, signal });
        window.addEventListener('resize', checkPendingElements, { passive: true, signal });
      }

      function animateCount(el: HTMLElement) {
        if (el.dataset.countAnimated === 'true') return;

        const target = Number(el.dataset.countTo ?? '0');
        if (!Number.isFinite(target)) return;

        const prefix = el.dataset.countPrefix ?? '';
        const suffix = el.dataset.countSuffix ?? '';
        const duration = Number(el.dataset.countDuration ?? '1600');
        const decimals = Number(el.dataset.countDecimals ?? '0');
        const startValue = Number(el.dataset.countFrom ?? '0');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const formatter = new Intl.NumberFormat('en-US', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        });

        const setValue = (value: number) => {
          el.textContent = `${prefix}${formatter.format(value)}${suffix}`;
        };

        el.dataset.countAnimated = 'true';

        if (reduceMotion) {
          setValue(target);
          return;
        }

        const startedAt = performance.now();

        const tick = (now: number) => {
          const progress = Math.min((now - startedAt) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const value = startValue + (target - startValue) * eased;
          setValue(progress === 1 ? target : value);

          if (progress < 1) requestAnimationFrame(tick);
        };

        requestAnimationFrame(tick);
      }

      function initCountups() {
        if (countupObserver) {
          countupObserver.disconnect();
          countupObserver = null;
        }

        const counters = document.querySelectorAll<HTMLElement>('[data-count-to]');
        if (!counters.length) return;

        const checkPendingCounters = () => {
          const pending = document.querySelectorAll<HTMLElement>('[data-count-to]:not([data-count-animated="true"])');
          if (!pending.length) return;
          const windowHeight = window.innerHeight;
          pending.forEach((counter) => {
            const rect = counter.getBoundingClientRect();
            if (rect.top <= windowHeight + 40) {
              animateCount(counter);
              countupObserver?.unobserve(counter);
            }
          });
        };

        countupObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting || entry.boundingClientRect.top <= window.innerHeight + 40) {
                animateCount(entry.target as HTMLElement);
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px 40px 0px' }
        );

        counters.forEach((counter) => {
          if (counter.dataset.countAnimated === 'true') return;
          const rect = counter.getBoundingClientRect();
          if (rect.top <= window.innerHeight + 40) {
            animateCount(counter);
          } else {
            countupObserver!.observe(counter);
          }
        });

        if (motionAbortController) {
          window.addEventListener('scroll', checkPendingCounters, {
            passive: true,
            signal: motionAbortController.signal,
          });
        }
      }

      function initPageMotion() {
        initScrollReveal();
        initCountups();
      }

      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.add('js');
      });
      document.addEventListener('astro:page-load', initPageMotion);
    </script>
  </body>
</html>
